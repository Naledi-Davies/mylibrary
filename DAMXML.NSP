0005DEFINE DATA LOCAL
00061 #XML     (A) DYNAMIC
00071 #MYNAME  (A) DYNAMIC
00081 #MYVALUE (A) DYNAMIC
00091 MYNAME   (A30)
00101 MYVALUE  (A30)
00111 #NAME    (A30)
00121 #VALUE   (A30)
0013END-DEFINE
0014*
0015DEFINE WORK FILE 1 'C:\training\splitdam.TXT'
0016DEFINE WORK FILE 2 'C:\Training\DAM-XML-2.XML'
0017*
0018READ WORK FILE 2 ONCE #XML
0019*
0020PARSE XML #XML INTO NAME #MYNAME VALUE #MYVALUE
0021  COMPRESS #MYNAME INTO MYNAME 
0022  COMPRESS #MYVALUE INTO MYVALUE 
0023*
0024  IF MYNAME GT ' '
0025    MOVE MYNAME TO #NAME
0026  END-IF
0027*
0028  IF MYVALUE GT ' '
0029    MOVE MYVALUE TO #VALUE
0030  WRITE WORK FILE 1 VARIABLE #NAME #VALUE
0031  END-IF
0032END-PARSE
0033END
