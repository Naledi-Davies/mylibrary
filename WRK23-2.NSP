0018/** New Program WRK23FIN.
0019/**
0020/** :author tda
0021
0022DEFINE DATA LOCAL
00231 EMP VIEW OF EMPLOYEES
0024  2 PERSONNEL-ID (A8)
0025  2 FIRST-NAME (A20)
0026  2 NAME (A20)
0027  2 GENDER (A1)
0028  2 CITY (A20)
0029  2 DEPT (A6)
0030  2 REDEFINE DEPT
0031    3 DEPT2 (A4)
0032  2 SALARY (P9.0/1:10)
0033  2 MAR-STAT (A1)
0034  2 CURR-CODE (A3/1:10)
0035  2 BONUS (P9.0/1:10,1:10)
00361 #SALARY (N9.0/1:10)
00371 #BONUS (N9.0/1:10,1:10)
0038****************************
00391 VEH VIEW OF VEHICLES
0040  2 PERSONNEL-ID (A8)
0041  2 MAKE (A20)
0042
0043* ARRAY OF VALID VEHICLES
00441 MAKE-ARRAY (A20/1:10) INIT 
0045<'MERCEDES','AUSTIN','BMW','FERRARI','VOLVO','MERCEDES-BENZ','CHRYSLER'>
0046
00471 #VEH-MAKE (A20)
0048
0049*************************
00501 NEW-SALARY (P9.0)
00511 OLD-SALARY (P9.0)
00521 INCREASE   (N5.2)
0053
0054**************************
00551 #INDEX (N5)
0056
0057END-DEFINE
0058
0059MOVE SALARY(*)    TO #SALARY(*)
0060MOVE BONUS(*,*)   TO #BONUS(*,*)
0061
0062
0063DEFINE WORK FILE 1 'C:\TRAINING\SALARYINCREASES.TXT'
0064
0065
0066READ EMP BY PERSONNEL-ID
0067
0068  MOVE 0.05 TO INCREASE
0069
0070  IF GENDER = 'F'
0071    ADD 0.02 TO INCREASE
0072  ELSE
0073    IF GENDER = 'M'
0074      SUBTRACT 0.01 FROM INCREASE
0075      IF MAR-STAT = 'S' OR MAR-STAT = 'D'
0076        ADD 0.01 TO INCREASE
0077        IF DEPT2 = 'MGMT'
0078          ADD 0 TO INCREASE
0079        END-IF
0080      END-IF
0081    END-IF
0082  END-IF
0083
0084* RESET VEHICLE FIELD
0085  RESET #VEH-MAKE
0086
0087  FIND VEH WITH PERSONNEL-ID = EMP.PERSONNEL-ID
0088
0089    EXAMINE MAKE-ARRAY(*) FOR MAKE GIVING INDEX IN #INDEX
0090
0091    IF #INDEX NE 0
0092      MOVE MAKE TO #VEH-MAKE
0093      RESET INCREASE
0094      ESCAPE BOTTOM
0095    END-IF
0096
0097  END-FIND
0098*
0099  WRITE
0100    PERSONNEL-ID DEPT /
0101    CURR-CODE (1) SALARY (1)
0102    BONUS (1,1) BONUS (1,2) BONUS (1,3) BONUS (1,4) /
0103    CURR-CODE (2) SALARY (2)
0104    BONUS (2,1) BONUS (2,2) BONUS (2,3) BONUS (2,4) /
0105    CURR-CODE (3) SALARY (3)
0106    BONUS (3,1) BONUS (3,2) BONUS (3,3) BONUS (3,4) /
0107    CURR-CODE (4) SALARY (4)
0108    BONUS (4,1) BONUS (4,2) BONUS (4,3) BONUS (4,4) /
0109    CURR-CODE (5) SALARY (5)
0110    BONUS (5,1) BONUS (5,2) BONUS (5,3) BONUS (5,4) /
0111    CURR-CODE (6) SALARY (6)
0112    BONUS (6,1) BONUS (6,2) BONUS (6,3) BONUS (6,4) /
0113    CURR-CODE (7) SALARY (7)
0114    BONUS (6,1) BONUS (7,2) BONUS (7,3) BONUS (7,4) /
0115    CURR-CODE (8) SALARY (8)
0116    BONUS (7,1) BONUS (8,2) BONUS (8,3) BONUS (8,4) /
0117    CURR-CODE (9) SALARY (9)
0118    BONUS (9,1) BONUS (9,2) BONUS (9,3) BONUS (9,4) /
0119
0120******** SHIFT OCCURRENCES ********
0121  FOR #INDEX = 10 TO 2 STEP -1
0122    MOVE SALARY(#INDEX - 1)    TO SALARY(#INDEX)
0123    MOVE CURR-CODE(#INDEX - 1) TO CURR-CODE(#INDEX)
0124    MOVE BONUS(#INDEX - 1,*) TO BONUS(#INDEX,*)
0125  END-FOR
0126  RESET CURR-CODE(1) SALARY(1) BONUS(1,*)
0127******** CALCULATE NEW SALARY ********
0128  OLD-SALARY := SALARY(2)
0129  NEW-SALARY := OLD-SALARY
0130  ADD (OLD-SALARY * INCREASE) TO NEW-SALARY
0131
0132******** STORE IN CURRENT YEAR (OCC 1) ********
0133  MOVE NEW-SALARY TO SALARY(1)
0134  MOVE CURR-CODE(2) TO CURR-CODE(1)
0135*
0136  UPDATE
0137* END TRANSACTION
0138******** WRITE OUTPUT ********
0139* RESET CURR-CODE (1) CURRENCY CODE WILL STAY THE SAME SO WE DON'T NEED TO RESET IT
0140
0141  RESET SALARY (1) BONUS (1,*)
0142  WRITE
0143    PERSONNEL-ID DEPT /
0144    CURR-CODE (1) SALARY (1)
0145    BONUS (1,1) BONUS (1,2) BONUS (1,3) BONUS (1,4) /
0146    CURR-CODE (2) SALARY (2)
0147    BONUS (2,1) BONUS (2,2) BONUS (2,3) BONUS (2,4) /
0148    CURR-CODE (3) SALARY (3)
0149    BONUS (3,1) BONUS (3,2) BONUS (3,3) BONUS (3,4) /
0150    CURR-CODE (4) SALARY (4)
0151    BONUS (4,1) BONUS (4,2) BONUS (4,3) BONUS (4,4) /
0152    CURR-CODE (5) SALARY (5)
0153    BONUS (5,1) BONUS (5,2) BONUS (5,3) BONUS (5,4) /
0154    CURR-CODE (6) SALARY (6)
0155    BONUS (6,1) BONUS (6,2) BONUS (6,3) BONUS (6,4) /
0156    CURR-CODE (7) SALARY (7)
0157    BONUS (6,1) BONUS (7,2) BONUS (7,3) BONUS (7,4) /
0158    CURR-CODE (8) SALARY (8)
0159    BONUS (7,1) BONUS (8,2) BONUS (8,3) BONUS (8,4) /
0160    CURR-CODE (9) SALARY (9)
0161    BONUS (9,1) BONUS (9,2) BONUS (9,3) BONUS (9,4) /
0162*
0163*   WRITE WORK FILE 1 VARIABLE  PERSONNEL-ID
0164*   WRITE WORK FILE 1 VARIABLE  FIRST-NAME
0165*   WRITE WORK FILE 1 VARIABLE  NAME
0166*   WRITE WORK FILE 1 VARIABLE  GENGER
0167*   WRITE WORK FILE 1 VARIABLE  DEPT2
0168*   WRITE WORK FILE 1 VARIABLE  MAR-STAT
0169*   WRITE WORK FILE 1 VARIABLE  OLD-SALARY
0170*   WRITE WORK FILE 1 VARIABLE  NEW-SALARY
0171*   WRITE WORK FILE 1 VARIABLE  INCREASE
0172*   WRITE WORK FILE 1 VARIABLE  #VEH-MAKE
0173*   WRITE WORK FILE 1 VARIABLE  #BONUS(*,*)
0174*   WRITE WORK FILE 1 VARIABLE  CURR-CODE(*)
0175END-READ
0176*
0177END
0178
