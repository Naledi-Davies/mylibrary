0013DEFINE DATA
0014PARAMETER
00151 #GENDER-DESCRIPTION(A10)
00161 #GENDER (A1) 
0017LOCAL
00181 #CHOOSE (A1/1:2)
00191 #INDEX (N1)
0020END-DEFINE
0021*
0022INPUT USING MAP "WK41GEN"
0023*
0024IF *PF-KEY = 'PF3'
0025  ESCAPE MODULE
0026END-IF
0027* 
0028DECIDE FOR FIRST CONDITION
0029  WHEN #CHOOSE(1) NE ' '
0030    MOVE 'F' TO #GENDER
0031    MOVE 'FEMALE' TO #GENDER-DESCRIPTION
0032
0033  WHEN #CHOOSE(2) NE ' '
0034    MOVE 'M' TO #GENDER
0035    MOVE 'MALE' TO #GENDER-DESCRIPTION
0036    
0037  WHEN  NONE
0038    REINPUT ' Please select one option with "X"'
0039 
0040END-DECIDE
0041END
