0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 EMPLOYEES VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8) 
0008  2 FIRST-NAME (A20)
0009  2 NAME (A20)
0010  2 ADDRESS-LINE (A20/1:1)
0011  2 CITY (A20)
0012  2 POST-CODE (A10)
0013  2 COUNTRY (A3)
0014  2 DEPT (A6) 
00151 #EMP-ARRAY (1:*)
0016  2 PERSONNEL-ID (A8)
0017  2 FIRST-NAME   (A20)
0018  2 NAME         (A20)
0019  2 ADDRESS-LINE (A20/1:1)
0020  2 CITY         (A20)
0021  2 POST-CODE    (A10)
0022  2 COUNTRY      (A3)
00231 #TEMP-RECORD
0024  2 PERSONNEL-ID (A8)
0025  2 FIRST-NAME   (A20)
0026  2 NAME         (A20)
0027  2 ADDRESS-LINE (A20/1:1)
0028  2 CITY         (A20)
0029  2 POST-CODE    (A10)
0030  2 COUNTRY      (A3)
00311 #INDEX (N5)
00321 #INNER (N5)
00331 #OUTER (N5)
0034END-DEFINE
0035* 
0036FORMAT LS = 250
0037*
0038READ EMPLOYEES BY DEPT EQ 'MGMT30'
0039*
0040  IF EMPLOYEES.DEPT NE 'MGMT30'
0041    ESCAPE BOTTOM
0042  END-IF
0043*
0044  ADD 1 TO #INDEX
0045*
0046RESIZE ARRAY #EMP-ARRAY TO (1:#INDEX)
0047MOVE BY NAME EMPLOYEES TO #EMP-ARRAY(#INDEX) /*THE INDEX INDICATES THE NUMBER OF OCCURANCES ON THE UPPERBOUND
0048END-READ
0049*
0050FOR #OUTER = #INDEX TO 1 STEP -1
0051  FOR #INNER = 1 TO (#INDEX - 1)
0052 IF #EMP-ARRAY.FIRST-NAME (#INNER) GT #EMP-ARRAY.FIRST-NAME (#INNER + 1)
0053      MOVE BY NAME #EMP-ARRAY(#INNER) TO #TEMP-RECORD
0054      MOVE BY NAME #EMP-ARRAY (#INNER + 1) TO #EMP-ARRAY (#INNER)
0055      MOVE BY NAME #TEMP-RECORD TO #EMP-ARRAY (#INNER + 1)
0056    END-IF
0057  END-FOR
0058END-FOR
0059*
0060FOR #INNER = 1 TO #INDEX
0061  WRITE
0062    EMPLOYEES.DEPT
0063    #EMP-ARRAY.PERSONNEL-ID (#INNER)
0064    #EMP-ARRAY.FIRST-NAME (#INNER)
0065    #EMP-ARRAY.NAME (#INNER)
0066    #EMP-ARRAY.ADDRESS-LINE(#INNER,1:1)
0067    #EMP-ARRAY.CITY (#INNER)
0068    #EMP-ARRAY.POST-CODE (#INNER)
0069    #EMP-ARRAY.COUNTRY (#INNER)
0070END-FOR
0071*
0072END
