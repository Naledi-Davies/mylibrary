0001/** New Program WRK41.
0002/**
0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL 
00061 EMPLOYEES-DDM VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8)
0008  2 NAME (A20)
0009  2 CITY (A20)
00101 RESTART-VALUE (A20)
00111 SELECTION (A1)
00121 CHASSIS-NUM (B4)
0013*******************************************
00141 #CITY (A20/1:16)
00151 #NAME (A20/1:16)
00161 #PERSONNEL-ID (A8/1:16)
00171 #SELECTION (A1/1:16)
00181 #INDEX (N3)
00191 EXIT (A9)
00201 #SELECT-INDEX (N3)
00211 START-VALUE (A20)
00221 BACK (A9)
00231 #FIRST-NAME (A20)
00241 #GENDER (A1)
00251 #LANGUAGE (A3/1:5)
00261 #MARITAL-STATUS (A1)
00271 #MIDDLE-NAME (A20)
00281 #PERSON-ID (A8)
00291 #SURNAME (A20)
0030*******************************************
00311 #COUNT (N3)
0032*******************************************
00331 #GENDER-DESCRIPTION (A10)
00341 #MARITAL-STATUS-DESCRIPTION (A20)
0035*****************#CV FIELDS****************
00361 #CV-DESCRIPTION (C)
00371 #CV-FIRST-NAME (C)
00381 #CV-LANGUAGE (C/1:5)
00391 #CV-MIDDLE-NAME (C)
00401 #CV-PERSON-ID (C)
00411 #CV-SURNAME (C)
00421 #CV-GENDER (C)
00431 #CV-MARITAL-STATUS (C)
0044********************************************
00451 #SELECT (A1/1:4)
00461 #CHOOSE (A1/1:2)
0047********************************************
00481 #LASTSEARCH (A20)
0049END-DEFINE
0050*
0051SET KEY
0052  PF3 NAMED  'EXIT'
0053  ENTR NAMED 'NEXT>>'
0054  PF1 = HELP
0055*
0056READ EMPLOYEES-DDM WITH REPOSITION
0057    BY NAME STARTING FROM START-VALUE
0058  /**     STARTING FROM RESTART-VALUE
0059*
0060  ADD 1 TO #INDEX
0061*
0062  MOVE PERSONNEL-ID TO #PERSONNEL-ID(#INDEX)
0063  MOVE NAME         TO #NAME (#INDEX)
0064  MOVE CITY         TO #CITY(#INDEX)
0065  MOVE SELECTION    TO #SELECTION(#INDEX)
0066* 
0067  IF #INDEX=16
0068    INPUT USING MAP "WRK41MAP"
0069    IF RESTART-VALUE NE ' '
0070      MOVE RESTART-VALUE TO START-VALUE #LASTSEARCH
0071      RESET RESTART-VALUE
0072      RESET #INDEX
0073      ESCAPE TOP REPOSITION
0074    END-IF
0075*
0076    IF *PF-KEY = 'PF3'
0077      ESCAPE BOTTOM
0078    END-IF
0079*
0080    RESET #INDEX
0081    FOR #SELECT-INDEX = 1 TO 16
0082      IF #SELECTION (#SELECT-INDEX) EQ 'A'
0083        CALLNAT "WRK41-2S" #PERSONNEL-ID(#SELECT-INDEX)
0084*         RESET #SELECTION(#SELECT-INDEX)
0085      END-IF
0086      IF #SELECTION (#SELECT-INDEX) EQ 'V'
0087    CALLNAT "WRK41SUB" #PERSONNEL-ID(#SELECT-INDEX) #NAME(#SELECT-INDEX)
0088      END-IF
0089      IF #SELECTION (#SELECT-INDEX) EQ 'C'
0090     CALLNAT "WK41COM" #PERSONNEL-ID(#SELECT-INDEX) #NAME(#SELECT-INDEX)
0091      END-IF 
0092      IF #SELECTION (#SELECT-INDEX) EQ 'P'
0093     CALLNAT "WK41PERS" #PERSONNEL-ID(#SELECT-INDEX) #NAME(#SELECT-INDEX)
0094      END-IF
0095    END-FOR
0096  END-IF
0097*
0098END-READ
0099*
0100IF #INDEX < 16
0101  RESET #PERSONNEL-ID(#INDEX+1:16)
0102    #NAME(#INDEX+1:16)
0103    #CITY(#INDEX+1:16)
0104  INPUT USING MAP "WRK41MAP"
0105END-IF
0106*
0107END
