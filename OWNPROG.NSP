0005DEFINE DATA LOCAL
00061 BREAD-NAME1 (A9) CONST <'SASKO'>
00071 BREAD-NAME2 (A9) CONST <'ALBANY'>
00081 BREAD-NAME3 (A9) CONST <'BLUERIBON'>
00091 BREAD-NAME4 (A9) CONST <'BAKERS'>
00101 SCAN-VALUE  (A3) CONST <'AN'>
0011END-DEFINE
0012*
0013IF BREAD-NAME1 = BREAD-NAME2
0014    OR BREAD-NAME1 = BREAD-NAME3
0015  WRITE 'BREAD' BREAD-NAME1 'IS EQUAL'
0016    BREAD-NAME2 'OR' BREAD-NAME3
0017END-IF
0018*
0019IF BREAD-NAME1 = BREAD-NAME2
0020    OR = BREAD-NAME3
0021  WRITE 'BREAD' BREAD-NAME1 'IS EQUAL'
0022    BREAD-NAME2 'OR' BREAD-NAME3
0023END-IF
0024*
0025IF BREAD-NAME4 = SCAN SCAN-VALUE
0026    AND BREAD-NAME4 = MASK (.'A'...)
0027  WRITE 'BREAD:' BREAD-NAME4 'CONTAINS' SCAN-VALUE 'AN A'
0028END-IF
0029END
