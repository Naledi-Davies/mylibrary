0013DEFINE DATA LOCAL
00141 #RECORD (A100)
00151 #NUMBER (A5)
00161 #COUNTRY-NAME (A30)
00171 #POPULATION (A15)
00181 #REGION (A20)
0019END-DEFINE
0020*
0021FORMAT PS=22
0022*
0023DEFINE WORK FILE 1 'C:\TRAINING\AFR-COUNTRIES.TXT'
0024*
0025READ WORK 1 #RECORD
0026   PERFORM ACCESS-#RECORD-DATA
0027
0028  DISPLAY
0029    #NUMBER
0030    #COUNTRY-NAME
0031    #POPULATION
0032    #REGION
0033*
0034  AT END OF DATA
0035    WRITE 'TOTAL NUMBER'
0036      COUNT (#RECORD)
0037  END-ENDDATA
0038END-WORK
0039DEFINE SUBROUTINE ACCESS-#RECORD-DATA
0040SEPARATE #RECORD INTO
0041  #NUMBER
0042  #COUNTRY-NAME
0043  #POPULATION
0044  #REGION
0045  WITH DELIMITERS '#'
0046*
0047EXAMINE #POPULATION FOR ',' DELETE
0048MOVE RIGHT #POPULATION TO #POPULATION
0049*
0050END-SUBROUTINE
0051
0052END
