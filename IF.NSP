0005DEFINE DATA LOCAL
00061 START-HARBOR  (A23) INIT <'JOHANNESBURG'>
00071 DEST-HARBOR   (A23) INIT <'PRETORIA'>
0008END-DEFINE
0009*
0010IF START-HARBOR = 'JOHANNESBURG'
0011    IF DEST-HARBOR = 'NELSPRUIT'
0012       START-HARBOR := 'DURBAN'
0013       DEST-HARBOR := 'PRETORIA'
0014    ELSE
0015    START-HARBOR := 'KIMBERLY'
0016    END-IF
0017 END-IF
0018*
0019WRITE '=' START-HARBOR /
0020      '=' DEST-HARBOR
0021END 
