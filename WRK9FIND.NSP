0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 EMPLOYEES-DDM VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8)
0008  2 NAME (A20)
0009  2 COUNTRY (A3)
0010  2 LANG (A3/1:5)
0011  2 C*LANG
0012  2 CITY
0013END-DEFINE 
0014FORMAT PS=100
0015FORMAT LS=150
0016READ1. READ EMPLOYEES-DDM BY PERSONNEL-ID
0017    WHERE EMPLOYEES-DDM.CITY EQ SCAN 'DARMSTADT'
0018*
0019  IF CITY NE 'DARMSTADT' 
0020    ESCAPE BOTTOM (READ1.)
0021  END-IF
0022*
0023  DISPLAY *ISN
0024    PERSONNEL-ID 
0025    NAME (AL=10)
0026    COUNTRY (AL=10)
0027    LANG (1)
0028    LANG (2)
0029    LANG (3)
0030    LANG (4)
0031    LANG (5)
0032    C*LANG 
0033END-READ
0034*
0035WRITE 'TOTAL'
0036  *COUNTER (READ1.)
0037
0038END
