0001/** New Program WRK41.
0002/**
0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL 
00061 EMPLOYEES-DDM VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8)
0008  2 NAME (A20)
0009  2 CITY (A20)
00101 RESTART-VALUE (A20)
00111 SELECTION (A1)
00121 CHASSIS-NUM (B4)
0013*****************************************
00141 #CITY (A20/1:16)
00151 #NAME (A20/1:16)
00161 #PERSONNEL-ID (A8/1:16)
00171 #SELECTION (A1/1:16)
00181 #INDEX (N3)
00191 EXIT (A9)
00201 #SELECT-INDEX (N3)
00211 START-VALUE (A20)
00221 BACK (A9)
0023********************************************
00241 #LASTSEARCH (A20)
0025END-DEFINE
0026* 
0027SET KEY
0028  PF3 NAMED  'EXIT'
0029  ENTR NAMED 'NEXT>>'
0030  PF4 ='<<PREVIOUS'
0031*   PF7 NAMED  '<<BACK'
0032*
0033* IF *PF-KEY = 'PF7'
0034*   ESCAPE TOP
0035* END-IF
0036READ EMPLOYEES-DDM WITH REPOSITION
0037    BY NAME STARTING FROM START-VALUE
0038  /**     STARTING FROM RESTART-VALUE
0039*
0040  ADD 1 TO #INDEX
0041*
0042  MOVE PERSONNEL-ID TO #PERSONNEL-ID(#INDEX)
0043  MOVE NAME         TO #NAME (#INDEX)
0044  MOVE CITY         TO #CITY(#INDEX)
0045  MOVE SELECTION    TO #SELECTION(#INDEX)
0046
0047* 
0048  IF #INDEX=16
0049    INPUT USING MAP "WRK41MAP"
0050    IF RESTART-VALUE NE ' '
0051      MOVE RESTART-VALUE TO START-VALUE #LASTSEARCH
0052      RESET RESTART-VALUE
0053      RESET #INDEX
0054      ESCAPE TOP REPOSITION
0055    END-IF
0056*
0057    IF *PF-KEY = 'PF3'
0058      ESCAPE BOTTOM
0059    END-IF
0060*
0061    RESET #INDEX
0062    FOR #SELECT-INDEX = 1 TO 16
0063      IF #SELECTION (#SELECT-INDEX) EQ 'A'
0064        CALLNAT "WRK41-2S" #PERSONNEL-ID(#SELECT-INDEX)
0065*         RESET #SELECTION(#SELECT-INDEX)
0066      END-IF
0067      IF #SELECTION (#SELECT-INDEX) EQ 'V'
0068    CALLNAT "WRK41SUB" #PERSONNEL-ID(#SELECT-INDEX) #NAME(#SELECT-INDEX)
0069      END-IF
0070       IF #SELECTION (#SELECT-INDEX) EQ 'C'
0071    CALLNAT "WK41COM" #PERSONNEL-ID(#SELECT-INDEX) #NAME(#SELECT-INDEX)
0072      END-IF 
0073    END-FOR
0074  END-IF
0075*
0076END-READ
0077
0078IF #INDEX < 16
0079  RESET #PERSONNEL-ID(#INDEX+1:16)
0080    #NAME(#INDEX+1:16)
0081    #CITY(#INDEX+1:16)
0082  INPUT USING MAP "WRK41MAP"
0083END-IF
0084*
0085END
