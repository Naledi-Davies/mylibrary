0004/* TODO Enter your code here
0005DEFINE DATA PARAMETER
00061 #PERSONNEL-ID (A8)
00071 #NAME (A20)
0008LOCAL 
00091 EMPLOYEE VIEW OF VEHICLES
0010  2 REG-NUM (A15)
0011  2 CHASSIS-NUM (B4)
0012  2 PERSONNEL-ID (A8) /* NC
0013  2 MAKE (A20)
0014  2 MODEL (A20)
0015  2 COLOUR (A10)
0016  2 YEAR (N4.0)
0017  2 DATE-ACQ (N8.0)
0018******************************************
00191 #CHASSIS-NUMBER (B4)
00201 #COLOUR (A10)
00211 #DATE-AQUIRED (N8)
00221 REDEFINE #DATE-AQUIRED
0023  2 DATE-AQUIRED (N4)
00241 #MAKE (A20)
00251 #MODEL (A20)
00261 #PERSON-ID (A8)
00271 #REGISTRATION-NUMBER (A15)
00281 #SURNAME (A20)
00291 #YEAR (N4)
0030*******************************************
00311 #COUNT (N3)
00321 #FOUND (L) /* WE ARE TRYING TO DETECT USING THIS FIELD IF A CAR EXISTS
0033****************CV FIELDS*****************************
00341 #CV-CHASSIS-NUMBER (C)
00351 #CV-COLOUR (C)
00361 #CV-DATE-AQUIRED (C)
00371 #CV-MAKE (C)
00381 #CV-MODEL (C)
00391 #CV-REGISTRATION-NUMBER (C)
00401 #CV-YEAR (C)
0041*****************YEAR VALIDATION FIELD****************
00421 #YEAR-ALPHA (A10)
00431 #DATE   (A10) 
00441 #DATE-D (D)
0045END-DEFINE
0046* 
0047SET KEY
0048  PF4 NAMED 'UPDATE'
0049*
0050MOVE (AD=P) TO   #CV-CHASSIS-NUMBER 
0051MOVE (AD=P) TO   #CV-COLOUR
0052MOVE (AD=P) TO   #CV-DATE-AQUIRED
0053MOVE (AD=P) TO   #CV-MAKE 
0054MOVE (AD=P) TO   #CV-MODEL
0055MOVE (AD=P) TO   #CV-REGISTRATION-NUMBER
0056MOVE (AD=P) TO   #CV-YEAR
0057*
0058SET CONTROL 'MT' /* MESSAGE IS PLACED ON TOP OF THE PROGRAM
0059* MOVE FALSE TO #FOUND /*This tells the program: At the start, assume the employee has no car."If a record is found later, the program will change it to TRUE.
0060*
0061FIND EMPLOYEE WITH PERSONNEL-ID = #PERSONNEL-ID
0062* IF NO RECORD FOUND ALWAYS DIRECTLY AFTER THE FIND!
0063
0064* MOVE TRUE TO #FOUND /* If a record is found later, the program will change it to TRUE.
0065  ADD 1 TO #COUNT
0066*
0067  MOVE PERSONNEL-ID      TO #PERSON-ID
0068  MOVE #NAME             TO #SURNAME
0069  MOVE REG-NUM           TO #REGISTRATION-NUMBER
0070  MOVE MAKE              TO #MAKE
0071  MOVE MODEL             TO #MODEL
0072  MOVE COLOUR            TO #COLOUR 
0073  MOVE YEAR              TO #YEAR
0074  MOVE CHASSIS-NUM       TO #CHASSIS-NUMBER
0075  MOVE DATE-ACQ          TO #DATE-AQUIRED
0076*
0077  INPUT USING MAP "WK41-3"
0078*
0079  IF *PF-KEY = 'PF4'
0080*
0081    MOVE (AD=I) TO   #CV-CHASSIS-NUMBER
0082    MOVE (AD=I) TO   #CV-COLOUR
0083    MOVE (AD=I) TO   #CV-DATE-AQUIRED
0084    MOVE (AD=I) TO   #CV-MAKE
0085    MOVE (AD=I) TO   #CV-MODEL
0086    MOVE (AD=I) TO   #CV-REGISTRATION-NUMBER
0087    MOVE (AD=I) TO   #CV-YEAR
0088*
0089    INPUT USING MAP "WK41-3"
0090*************VALIDATION***************************
0091    IF #SURNAME = ' '
0092      REINPUT 'SURNAME MUST BE ENTERED' MARK *#SURNAME
0093    END-IF
0094    IF #REGISTRATION-NUMBER = ' '
0095      REINPUT 'REGISTRATION IS REQUIRED' MARK  *#REGISTRATION-NUMBER
0096    END-IF
0097    IF #MAKE = ' '
0098      REINPUT 'INSERT MAKE OF THE CAR' MARK *#MAKE
0099    END-IF
0100    IF #MODEL =  ' '
0101      REINPUT 'ENTER CAR MODEL' MARK *#MODEL
0102    END-IF
0103    IF #COLOUR = ' '
0104      REINPUT 'SPECIFY COLOUR OF YOUR CAR' MARK *#COLOUR
0105    END-IF
0106*    
0107    IF #YEAR = 0
0108      REINPUT 'YEAR MUST BE ENTERED (YYYY)'
0109        MARK *#YEAR
0110    END-IF
0111*
0112    IF #YEAR < 1900 OR #YEAR > 2100
0113      REINPUT 'INVALID YEAR (1900-2100)'
0114        MARK *#YEAR
0115    END-IF
0116    IF #CHASSIS-NUMBER= ' '
0117      REINPUT 'INSERT CORRECT CHASSIS NUMBER' MARK *#CHASSIS-NUMBER
0118    END-IF
0119    IF NOT (#DATE-AQUIRED = MASK(YYYYMMDD))
0120      REINPUT 'DATE ACQUIRED MUST BE ENTERED' MARK *#DATE-AQUIRED
0121    END-IF
0122    IF DATE-AQUIRED < #YEAR
0123      REINPUT 'INVALID' MARK *#DATE-AQUIRED 
0124    END-IF
0125******************* MOVE DATA BACK TO DATABASE****************
0126    MOVE #PERSONNEL-ID        TO PERSONNEL-ID
0127    MOVE #SURNAME             TO #NAME
0128    MOVE #REGISTRATION-NUMBER TO REG-NUM
0129    MOVE #MAKE                TO MAKE
0130    MOVE #MODEL               TO MODEL
0131    MOVE #COLOUR              TO COLOUR
0132    MOVE #YEAR                TO YEAR
0133    MOVE #CHASSIS-NUMBER      TO CHASSIS-NUM
0134    MOVE #DATE-AQUIRED        TO DATE-ACQ
0135
0136*
0137    MOVE (AD=P) TO   #CV-CHASSIS-NUMBER
0138    MOVE (AD=P) TO   #CV-COLOUR
0139    MOVE (AD=P) TO   #CV-DATE-AQUIRED
0140    MOVE (AD=P) TO   #CV-MAKE
0141    MOVE (AD=P) TO   #CV-MODEL
0142    MOVE (AD=P) TO   #CV-REGISTRATION-NUMBER
0143    MOVE (AD=P) TO   #CV-YEAR
0144*
0145    UPDATE
0146*     END TRANSACTION
0147    INPUT WITH TEXT 'RECORD SUCCESSFULLY UPDATED' USING MAP "WK41-3"
0148*
0149  END-IF
0150END-FIND
0151*
0152IF #COUNT = 0
0153  WRITE / 'EMPLOYEE:' #NAME
0154    / 'THIS EMPLOYEE HAS NO CAR REGISTERED.'
0155END-IF
0156* IF #FOUND = FALSE /* NOW WE CHECK IF WE FOUND A RECORD AND IF IT IS NOT FOUND WE PRINT THAT THE EMPLOYEE HAS NO CAR
0157*   WRITE / 'EMPLOYEE:' #NAME
0158*     / 'THIS EMPLOYEE HAS NO CAR REGISTERED.'
0159* END-IF
0160*
0161END
