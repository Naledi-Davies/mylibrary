0013DEFINE DATA PARAMETER
00141 #PERSONNEL-ID (A8)
00151 #NAME (A20)
0016LOCAL 
00171 EMPLOYEE VIEW OF EMPLOYEES
0018  2 PERSONNEL-ID (A8)
0019  2 NAME (A20)
0020  2 DEPT (A6)
0021  2 JOB-TITLE (A25)
0022  2 CURR-CODE (A3/1:3)
0023  2 SALARY (P9.0/1:3)
0024  2 BONUS (P9.0/1:3,1:3)
0025  2 LEAVE-DUE (N2.0)
0026  2 LEAVE-TAKEN (N2.0)
0027  2 LEAVE-BOOKED (1:3)
0028    3 START (N8.0)
0029    3 END (N8.0)
0030*****************************************
00311 #BONUS (P9/1:3,1:3)
00321 #CURRENCY (A3/1:3)
00331 #DEPATMENT (A6)
00341 #JOB-TITLE (A25)
00351 #LEAVE-DUE (N2)
00361 #LEAVE-END (N8/1:3)   
00371 #LEAVE-START (N8/1:3) 
00381 #LEAVE-TAKEN (N2)
00391 #PERSON-ID (A8)
00401 #SALARY (P9/1:3)
00411 #SURNME (A20)
0042*******************************************
00431 #COUNT (N3)
0044***************CV FIELDS*******************
00451 #CV-DEPARTMENT (C)
00461 #CV-JOB-TITLE (C)
0047END-DEFINE
0048*
0049FORMAT PS =80
0050SET KEY
0051  PF4 NAMED 'UPDATE'
0052*
0053MOVE (AD=P) TO
0054  #CV-DEPARTMENT
0055  #CV-JOB-TITLE
0056*
0057FIND EMPLOYEE WITH PERSONNEL-ID = #PERSONNEL-ID
0058*
0059  ADD 1 TO #COUNT
0060*
0061  MOVE PERSONNEL-ID      TO #PERSON-ID
0062  MOVE #NAME             TO #SURNME
0063  MOVE DEPT              TO #DEPATMENT
0064  MOVE JOB-TITLE         TO #JOB-TITLE
0065  MOVE CURR-CODE(1:1)    TO #CURRENCY(1:3)
0066  MOVE SALARY  (1:3)     TO #SALARY(1:3)
0067  MOVE BONUS(1:3,1:3)    TO #BONUS(1:3,1:3)
0068  MOVE LEAVE-DUE         TO #LEAVE-DUE
0069  MOVE LEAVE-TAKEN       TO #LEAVE-TAKEN
0070  MOVE  START(1:3)       TO #LEAVE-START(1:3)
0071  MOVE  END(1:3)         TO #LEAVE-END(1:3) 
0072*
0073  INPUT USING MAP "WK41COM4"
0074*
0075  IF *PF-KEY = 'PF4'
0076*
0077    MOVE (AD=I) TO
0078      #CV-DEPARTMENT
0079      #CV-JOB-TITLE
0080*
0081    INPUT USING MAP "WK41COM4"
0082***************************VALIDATE BEFORE UPDATE***********************
0083    IF #DEPATMENT = ' '
0084      REINPUT 'DEPARTMENT MUST BE ENTERED' MARK *#DEPATMENT
0085    END-IF
0086    IF #JOB-TITLE = ' '
0087      REINPUT 'JOB-TITLE MUST BE ENTERED' MARK  *#JOB-TITLE
0088    END-IF
0089*    
0090    MOVE #PERSON-ID        TO PERSONNEL-ID
0091    MOVE #SURNME           TO #NAME
0092    MOVE #DEPATMENT        TO DEPT
0093    MOVE #JOB-TITLE        TO JOB-TITLE
0094    MOVE #CURRENCY(1:3)    TO CURR-CODE(1:3)
0095    MOVE #SALARY(1:3)      TO SALARY(1:3)
0096    MOVE #BONUS(1:3,1:3)   TO BONUS(1:3,1:3)
0097    MOVE #LEAVE-DUE        TO LEAVE-DUE
0098    MOVE #LEAVE-TAKEN      TO LEAVE-TAKEN
0099    MOVE #LEAVE-START(1:3) TO START(1:3)
0100    MOVE #LEAVE-END(1:3)   TO END(1:3)
0101*
0102    MOVE (AD=P) TO
0103      #CV-DEPARTMENT
0104      #CV-JOB-TITLE
0105*
0106    UPDATE
0107*     END TRANSACTION
0108INPUT WITH TEXT 'COMPANY DETAILS SUCCESSFULLY UPDATED'  USING MAP "WK41COM4"
0109*
0110  END-IF
0111END-FIND 
0112*
0113END
0114
