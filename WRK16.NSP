0038*     'PERD-ID'EMPLOYEES-DDM.PERSONNEL-ID (AL=8)
0039*     'NAME'EMPLOYEES-DDM.NAME (AL=15)
0040*     'CITY' EMPLOYEES-DDM.CITY (AL=15)
0041*     'TOTAL CARS' #RESULT
0042END-READ
0043* 
0044* WRITE 'TOTAL CARS FOUND' TOT-CARS
0045END
