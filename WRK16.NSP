0005DEFINE DATA LOCAL
00061 EMPLOYEES-DDM VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8)
0008  2 NAME (A20)
0009  2 CITY (A20)
00101 #RESULT (N4)
00111 #EXIT (A9)
00121 TOT-CARS (N5)
0013END-DEFINE
0014*
0015SET KEY 
0016PF1=HELP
0017PF3 NAMED 'EXIT'
0018*
0019FORMAT LS=120
0020FORMAT PS=22
0021*
0022READ EMPLOYEES-DDM BY PERSONNEL-ID
0023*
0024  CALLNAT "WRK16SUB" PERSONNEL-ID #RESULT
0025*
0026  INPUT USING MAP "WRKMAP"
0027*
0028IF *PF-KEY = 'PF3'
0029ESCAPE BOTTOM
0030END-IF
0031*   IF #EXIT = 'T'
0032*     ESCAPE BOTTOM
0033*   END-IF
0034*
0035  ADD #RESULT TO TOT-CARS
