0005DEFINE DATA PARAMETER
00061 VALUE-1 (N4.4)
00071 VALUE-2 (N4.4)  
00081 OPERATOR (A1) 
00091 RESULT (N4.4) 
0010END-DEFINE
0011  DECIDE ON FIRST OPERATOR
0012    VALUE '+'
0013      COMPUTE RESULT = VALUE-1 + VALUE-2
0014    VALUE '-'
0015      COMPUTE RESULT = VALUE-1 - VALUE-2
0016    VALUE '/'
0017      COMPUTE RESULT = VALUE-1 / VALUE-2
0018    VALUE '*'
0019       COMPUTE RESULT = VALUE-1 * VALUE-2
0020*
0021      NONE /*NONE IS COMPULSORY
0022      IGNORE     
0023 END-DECIDE
0024END
