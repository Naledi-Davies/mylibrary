0005DEFINE DATA LOCAL 
00061 EMP VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8)
0008  2 NAME (A20)
0009  2 REDEFINE NAME
0010    3 N (A1)
0011    3 NAM (A19)
0012  2 DEPT (A6)
0013  2 DEPT-PERSON (A26)
0014* REDEFINED SUPERDESCRIPTOR TO SET UP KEY
00151 #DEPT-PERSON (A26)
00161 REDEFINE #DEPT-PERSON
0017  2 #DEPT(A6)
0018  2 #NAME(A20)
00191 #TIME (T) 
00201 #DATE (D) 
0021END-DEFINE
0022*
0023DEFINE WORK FILE 1 'C:\TRAINING\SUPERDESCRIPTOR.TXT'
0024**SET UP KEY
0025MOVE 'TECH10' TO #DEPT-PERSON.#DEPT
0026MOVE 'D' TO #DEPT-PERSON.#NAME
0027* * MOVE EDITED *TIMESTMP TO #TIME (EM=HH:II:SS.T)
0028* MOVE EDITED *DATX TO #DATE (EM=YYYY-MM-DD)
0029*
0030READ EMP BY DEPT-PERSON
0031    FROM #DEPT-PERSON
0032*
0033  IF EMP.DEPT NE #DEPT-PERSON.#DEPT
0034    ESCAPE BOTTOM
0035  END-IF
0036*
0037  IF EMP.N GT 'J'
0038    ESCAPE BOTTOM
0039  END-IF
0040*
0041*   DISPLAY
0042*     NAME
0043*     DEPT
0044*     PERSONNEL-ID
0045*     #TIME (EM=DD-MM-YYYY' 'HH:II.SS.T)
0046*     #DATE (EM=DD-MM-YYYY' 'HH:II.SS.T)
0047  WRITE WORK FILE 1  NAME   '  '  DEPT '   ' PERSONNEL-ID
0048* *
0049END-READ
0050*
0051END
