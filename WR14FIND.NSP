0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 SA-DAM (A100)
00071 NAME-DAM (A35)
00081 LOCALE (A30)
00091 PROVINCE (A35)
00101 IMPOUNDS (A35)
00111 YEAR-COMPLETED (A4)
00121 RESEVOIR-VOL (A12)
00131 SURFACE-AREA (A12)
00141 WALL-HEIGHT  (A8)
00151 #COUNTER (N5)
0016*
0017END-DEFINE
0018*
0019FORMAT LS=244
0020*
0021DEFINE WORK FILE 1
0022  'C:\TRAINING\DAMS LIST NEW.TXT'
0023* 
0024DEFINE WORK FILE 2 
0025  'C:\TRAINING\DAMS LIST NEW2.TXT' 
0026*
0027READ1. READ WORK 1 SA-DAM 
0028  SEPARATE SA-DAM INTO
0029    NAME-DAM
0030    LOCALE
0031    PROVINCE
0032    IMPOUNDS
0033    YEAR-COMPLETED
0034    RESEVOIR-VOL 
0035    SURFACE-AREA
0036    WALL-HEIGHT
0037    WITH DELIMITERS '#'
0038*
0039  MOVE RIGHT RESEVOIR-VOL TO RESEVOIR-VOL
0040  MOVE RIGHT SURFACE-AREA TO SURFACE-AREA
0041  MOVE RIGHT WALL-HEIGHT  TO WALL-HEIGHT
0042  WRITE WORK 2
0043    NAME-DAM
0044    LOCALE
0045    PROVINCE
0046    IMPOUNDS
0047    YEAR-COMPLETED
0048    RESEVOIR-VOL
0049    SURFACE-AREA
0050    WALL-HEIGHT
0051*
0052  AT END OF DATA
0053    WRITE 'TOTAL DAMS IN SOUTH AFRICA'
0054      COUNT (#COUNTER)
0055  END-ENDDATA
0056END-WORK
0057*
0058CLOSE WORK FILE 1
0059CLOSE WORK FILE 2
0060*
0061END
