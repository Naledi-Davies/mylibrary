0001/** New Program CALWRK.
0002/**
0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 CALWRKSB 
0007  2 VALUE-1 (N4.4)
0008  2 VALUE-2 (N4.4)
0009  2 OPERATOR (A1)
0010  2 RESULT (N4.4)
0011END-DEFINE
0012REPEAT 
0013  INPUT 'PLEASE ENTER THE INFORMATION FOR THE CALCULATION'
0014    'VALUE 1:'            VALUE-1 (AD=M) //
0015    'VALUE 2:'            VALUE-2 (AD=M) //
0016    'OPERATOR:'           OPERATOR //
0017    'RESULT'              RESULT (AD=O)
0018  IF OPERATOR = '#'
0019    ESCAPE BOTTOM
0020  END-IF
0021  IF NOT OPERATOR = '+' OR ='-' OR ='*' OR = '/'
0022    REINPUT 'INVALID OPERATOR, TRY AGAIN'
0023      MARK *OPERATOR
0024  END-IF
0025  IF OPERATOR = '/'
0026  AND VALUE-2 = 0 
0027  REINPUT 'ERROR, YOU CANNOT DEVIDE BY 0'
0028  MARK *VALUE-2
0029  END-IF
0030  CALLNAT "CALWRKSB" VALUE-1 VALUE-2 OPERATOR RESULT
0031END-REPEAT
0032END
0033
