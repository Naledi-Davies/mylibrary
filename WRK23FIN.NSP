0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 EMP VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8)
0008  2 FIRST-NAME (A20)
0009  2 NAME (A20)
0010  2 GENDER (A1)
0011  2 CITY (A20)
0012  2 DEPT (A6)
0013  2 REDEFINE DEPT
0014    3 DEPT2 (A4)
0015  2 SALARY (P9.0/1:1)
0016  2 MAR-STAT (A1)
0017***********************
00181 VEH VIEW OF VEHICLES
0019  2 MAKE (A20)
0020* WE START BY INITILISING OUR ARRAY FOR SPECIFIC VEHICLES
00211 MAKE-ARRAY (A20/1:10) INIT (V) <'MERCEDES','AUSTIN', 'BMW','FERRARI', 'VOLVO','MERCEDES-BENZ','CHRYSLER'>
0022* BEFORE WE FIND WE MUST REST OUR NEW #MAKE-VEH TO MAKE SURE IT IS EMPTY SO WE CAN MOVE WHATS IN MAKE TO THIS NEW FIELD
00231 #VEH-MAKE (A20)
0024*************************
00251 NEW-SALARY (P9.0)
00261 OLD-SALARY (P9.0)
00271 INCREASE   (N5.2)
0028**************************
00291 #INDEX (N5)
0030END-DEFINE
0031*
0032DEFINE WORK FILE 1 'C:\TRAINING\CREASES.csv'
0033  TYPE 'csv'
0034*
0035READ EMP BY PERSONNEL-ID
0036*
0037  MOVE 0.05 TO INCREASE
0038*
0039  IF GENDER = 'F'
0040    ADD 0.02 TO INCREASE
0041  ELSE
0042    IF  GENDER = 'M'
0043      SUBTRACT 0.01 FROM INCREASE
0044      IF  MAR-STAT = 'S' OR MAR-STAT = 'D'
0045        ADD 0.01 TO INCREASE
0046        IF DEPT2 = 'MGMT'
0047          ADD 0 TO INCREASE
0048        END-IF
0049      END-IF
0050    END-IF
0051  END-IF
0052* RESET BEFORE FIND
0053  RESET #VEH-MAKE
0054  FIND VEH WITH PERSONNEL-ID = EMP.PERSONNEL-ID
0055*
0056    EXAMINE MAKE-ARRAY(*) FOR MAKE GIVING INDEX IN #INDEX
0057    IF #INDEX NE 0
0058      MOVE MAKE TO #VEH-MAKE
0059      RESET INCREASE
0060      ESCAPE BOTTOM
0061    END-IF
0062*
0063  END-FIND
0064******** CALCULATE***************
0065  OLD-SALARY := SALARY(1)
0066  MOVE OLD-SALARY TO NEW-SALARY
0067  ADD (OLD-SALARY * INCREASE) TO NEW-SALARY
0068*
0069  WRITE WORK FILE 1 VARIABLE
0070    PERSONNEL-ID
0071    FIRST-NAME
0072    NAME
0073    GENDER
0074    DEPT2
0075    MAR-STAT
0076    OLD-SALARY
0077    NEW-SALARY
0078    INCREASE
0079    #VEH-MAKE
0080*
0081END-READ
0082END
