0005DEFINE DATA PARAMETER
00061 PERSONNEL-ID (A8)
00071 NAME (A20) 
0008LOCAL
00091 VEHICLES VIEW OF VEHICLES
0010  2 MAKE (A20)
0011  2 MODEL (A20)
0012  2 COLOUR (A10)
0013  2 YEAR (N4.0)
0014*********************************************************************
00151 #PERSONNEL-ID (A8/1:1)
00161 #MAKE (A20/1:5)
00171 #MODEL (A20/1:5)
00181 #COLOUR (A10/1:5)
00191 #YEAR (N4.0/1:5)
0020**************************
00211 #INDEX (N3)
0022END-DEFINE
0023*
0024FIND VEHICLES WITH PERSONNEL-ID EQ PERSONNEL-ID
0025*
0026  ADD 1 TO #INDEX
0027  MOVE PERSONNEL-ID TO #PERSONNEL-ID(#INDEX)
0028  MOVE MAKE         TO #MAKE(#INDEX)
0029  MOVE MODEL        TO #MODEL(#INDEX)
0030  MOVE COLOUR       TO #COLOUR(#INDEX)
0031  MOVE YEAR         TO #YEAR(#INDEX)
0032* 
0033END-FIND
0034*
0035INPUT USING MAP "WS163MAP"
0036*
0037END
