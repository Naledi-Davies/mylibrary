0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA PARAMETER
00061 #PERSONNEL-ID (A8)
0007LOCAL 
00081 EMPLOYEE VIEW OF EMPLOYEES
0009  2 PERSONNEL-ID (A8)
0010  2 ADDRESS-LINE (A20/1:2)
0011  2 NAME (A20)
0012  2 CITY (A20)
0013  2 POST-CODE (A10)
0014  2 COUNTRY (A3)
0015  2 AREA-CODE (A6)
0016  2 PHONE (A15)
0017******************************************
00181 #PERSON-ID (A20)
00191 #SURNAME (A20)
00201 #POSTAL-CODE (A10)
00211 #ADDRESS (A20/1:2)
00221 #CITY (A20)
00231 #COUNTRY (A3)
00241 #AREA-CODE (A6)
00251 #TELEPHONE (A15)
0026*************cv-fields*******************  
00271 #CV-ADDRESS (C/1:2)
00281 #CV-AREA-CODE (C)
00291 #CV-CITY (C)
00301 #CV-POSTAL-CODE (C)
00311 #CV-SURNAME (C)
00321 #CV-TELEPHONE (C)
0033
0034END-DEFINE
0035*
0036SET KEY
0037  PF4 NAMED 'UPDATE'
0038*
0039MOVE (AD=P) TO   #CV-ADDRESS(1:2)
0040MOVE (AD=P) TO   #CV-AREA-CODE
0041MOVE (AD=P) TO   #CV-CITY
0042MOVE (AD=P) TO   #CV-POSTAL-CODE
0043MOVE (AD=P) TO   #CV-SURNAME
0044MOVE (AD=P) TO   #CV-TELEPHONE
0045*
0046FIND EMPLOYEE WITH PERSONNEL-ID = #PERSONNEL-ID
0047*
0048  MOVE PERSONNEL-ID      TO #PERSON-ID
0049  MOVE NAME              TO #SURNAME
0050  MOVE CITY              TO #CITY
0051  MOVE POST-CODE         TO #POSTAL-CODE
0052  MOVE ADDRESS-LINE(1:2) TO #ADDRESS(1:2)
0053  MOVE COUNTRY           TO #COUNTRY 
0054  MOVE AREA-CODE         TO #AREA-CODE
0055  MOVE PHONE             TO #TELEPHONE
0056*
0057  INPUT USING MAP "UPDEMP"
0058*
0059  IF *PF-KEY = 'PF4'
0060*
0061    MOVE (AD=I) TO      #CV-ADDRESS(1:2)
0062    MOVE (AD=I) TO      #CV-AREA-CODE
0063    MOVE (AD=I) TO     #CV-CITY
0064    MOVE (AD=I) TO      #CV-POSTAL-CODE
0065    MOVE (AD=I) TO      #CV-SURNAME
0066    MOVE (AD=I) TO     #CV-TELEPHONE
0067*
0068    INPUT USING MAP "UPDEMP"
0069*************VALIDATION***************************
0070    IF #SURNAME = ' '
0071      REINPUT 'SURNAME MUST BE ENTERED' MARK *#SURNAME
0072    END-IF
0073    IF #ADDRESS(1) = ' '
0074      REINPUT 'PLEASE ENTER VALID ADDRESS' MARK  *#ADDRESS(1)
0075    END-IF
0076    IF #AREA-CODE = ' '
0077      REINPUT 'PLEASE ENTER VALID AREA COE' MARK *#AREA-CODE
0078    END-IF
0079    IF #CITY =  ' '
0080      REINPUT 'PLEASE ENTER A CITY' MARK *#CITY
0081    END-IF
0082    IF #POSTAL-CODE = ' '
0083      REINPUT 'PLEASE ENTER VALID POSTAL CODE' MARK *#POSTAL-CODE
0084    END-IF
0085    IF #TELEPHONE = ' '
0086      REINPUT 'INSERT TELEPHONE NUMBER' MARK *#TELEPHONE
0087    END-IF
0088******************* MOVE DATA BACK TO DATABASE****************
0089    MOVE #PERSONNEL-ID  TO PERSONNEL-ID
0090    MOVE #SURNAME       TO NAME
0091    MOVE #CITY          TO CITY
0092    MOVE #POSTAL-CODE   TO POST-CODE
0093    MOVE #ADDRESS(1:2)  TO ADDRESS-LINE(1:2)
0094    MOVE #COUNTRY       TO COUNTRY
0095    MOVE #AREA-CODE     TO AREA-CODE
0096    MOVE #TELEPHONE     TO PHONE
0097*
0098
0099    MOVE (AD=P) TO      #CV-ADDRESS(1:2)
0100    MOVE (AD=P) TO      #CV-AREA-CODE
0101    MOVE (AD=P) TO      #CV-CITY
0102    MOVE (AD=P) TO      #CV-POSTAL-CODE
0103    MOVE (AD=P) TO      #CV-SURNAME
0104    MOVE (AD=P) TO      #CV-TELEPHONE
0105    UPDATE
0106*     END TRANSACTION
0107    INPUT WITH TEXT 'RECORD SUCCESSFULLY UPDATED' USING MAP "UPDEMP"
0108*
0109  END-IF
0110END-FIND
0111*
0112END
0113
