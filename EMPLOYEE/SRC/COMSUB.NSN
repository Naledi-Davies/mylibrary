0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA PARAMETER
00061 #PERSONNEL-ID (A8)
0007LOCAL
00081 EMPLOYEES VIEW OF EMPLOYEES
0009  2 PERSONNEL-ID (A8)
0010  2 JOB-TITLE (A25)
0011  2 DEPARTMENT (A4)
0012********************************
00131 #CV-DEPARTMENT (C)
00141 #CV-JOB-TITLE (C)
00151 #DEPARTMENT (A4)
00161 #JOB-TITLE (A25)
00171 #PERSON-ID (A8)
00181 #PROGRAM (A8) INIT <*PROGRAM>
0019END-DEFINE
0020*
0021SET KEY
0022  PF4 NAMED 'UPDATE'
0023*
0024MOVE (AD=P) TO
0025  #CV-DEPARTMENT
0026  #CV-JOB-TITLE
0027*
0028FIND EMPLOYEES WITH PERSONNEL-ID = #PERSONNEL-ID
0029*
0030  MOVE PERSONNEL-ID      TO #PERSON-ID
0031  MOVE DEPARTMENT        TO #DEPARTMENT
0032  MOVE JOB-TITLE         TO #JOB-TITLE
0033*
0034  INPUT USING MAP "COMMAP"
0035*
0036  IF *PF-KEY = 'PF4'
0037*
0038    MOVE (AD=I) TO
0039      #CV-DEPARTMENT
0040      #CV-JOB-TITLE
0041*
0042    INPUT USING MAP "COMMAP"
0043***************************VALIDATE BEFORE UPDATE***********************
0044    IF #DEPARTMENT = ' '
0045      REINPUT 'DEPARTMENT MUST BE ENTERED' MARK *#DEPARTMENT
0046    END-IF
0047    IF #JOB-TITLE = ' '
0048      REINPUT 'JOB-TITLE MUST BE ENTERED' MARK  *#JOB-TITLE
0049    END-IF
0050*    
0051    MOVE #PERSON-ID        TO PERSONNEL-ID
0052    MOVE #DEPARTMENT       TO DEPARTMENT
0053    MOVE #JOB-TITLE        TO JOB-TITLE
0054*
0055    MOVE (AD=P) TO
0056      #CV-DEPARTMENT
0057      #CV-JOB-TITLE
0058*
0059*     UPDATE
0060*     END TRANSACTION
0061INPUT WITH TEXT 'COMPANY DETAILS SUCCESSFULLY UPDATED'  USING MAP "COMMAP"
0062*
0063  END-IF
0064END-FIND
0065END
