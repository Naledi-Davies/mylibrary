0005DEFINE DATA PARAMETER
00061 #COUNTRY (A3)
0007LOCAL
00081 #INDEX (N5)
00091 #SEL (A1/1:6) 
0010END-DEFINE
0011*
0012INPUT USING MAP "COUNTRY"
0013*
0014FOR #INDEX = 1 TO 7
0015  IF #SEL(1)= 'X'
0016    MOVE 'GER' TO #COUNTRY
0017  END-IF
0018*
0019  IF #SEL(2)= 'X'
0020    MOVE 'DNK' TO #COUNTRY
0021  END-IF
0022*
0023  IF #SEL(3)= 'X'
0024    MOVE 'FRA' TO #COUNTRY
0025  END-IF
0026*
0027  IF #SEL(4)= 'X'
0028    MOVE 'USA' TO #COUNTRY
0029  END-IF
0030*
0031  IF #SEL(5)= 'X'
0032    MOVE 'UK' TO #COUNTRY
0033  END-IF
0034*
0035  IF #SEL(6)= 'X'
0036    MOVE 'ESP' TO #COUNTRY
0037  END-IF
0038*
0039END-FOR
0040* 
0041END
