0001/** New Subprogram ADDEMPL.
0002/**
0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA PARAMETER
00061 #P-ID (A8)
0007LOCAL 
00081 EMPLOYEE VIEW OF EMPLOYEES
0009  2 PERSONNEL-ID (A8)
0010  2 ADDRESS-LINE (A20/1:2)
0011  2 NAME (A20)
0012  2 CITY (A20)
0013  2 POST-CODE (A10)
0014  2 COUNTRY (A3)
0015  2 AREA-CODE (A6)
0016  2 PHONE (A15)
0017******************************************
00181 #PERSON-ID (A20)
00191 #SURNAME (A20)
00201 #POSTAL-CODE (A10)
00211 #ADDRESS (A20/1:2)
00221 #CITY (A20)
00231 #COUNTRY (A3)
00241 #AREA-CODE (A6)
00251 #TELEPHONE (A15)
0026*************cv-fields********************  
00271 #CV-ADDRESS (C/1:2)
00281 #CV-AREA-CODE (C)
00291 #CV-CITY (C)
00301 #CV-POSTAL-CODE (C)
00311 #CV-SURNAME (C)
00321 #CV-TELEPHONE (C)
00331 #PROGRAM (A8) INIT <*PROGRAM>
0034END-DEFINE
0035*
0036SET KEY
0037  PF4 NAMED 'ADD'
0038  PF3 NAMED 'BACK'
0039*
0040MOVE (AD=P) TO   #CV-ADDRESS(1:2)
0041MOVE (AD=P) TO   #CV-AREA-CODE
0042MOVE (AD=P) TO   #CV-CITY
0043MOVE (AD=P) TO   #CV-POSTAL-CODE
0044MOVE (AD=P) TO   #CV-SURNAME
0045MOVE (AD=P) TO   #CV-TELEPHONE
0046*
0047  INPUT USING MAP "ADDEM"
0048*
0049IF *PF-KEY = 'PF3'
0050  FETCH "LISTPROG"
0051END-IF
0052*
0053READ(1) EMPLOYEE IN DESCENDING WITH PERSONNEL-ID 
0054*   IF PERSONNEL-ID IS (N8)
0055*     #P-ID :=  VAL(PERSONNEL-ID)
0056*
0057*   MOVE PERSONNEL-ID      TO #PERSON-ID
0058*   MOVE NAME              TO #SURNAME
0059*   MOVE CITY              TO #CITY
0060*   MOVE POST-CODE         TO #POSTAL-CODE
0061*   MOVE ADDRESS-LINE(1:2) TO #ADDRESS(1:2)
0062*   MOVE COUNTRY           TO #COUNTRY 
0063*   MOVE AREA-CODE         TO #AREA-CODE
0064*   MOVE PHONE             TO #TELEPHONE
0065*
0066
0067*
0068  IF *PF-KEY = 'PF4'
0069*
0070    MOVE (AD=I) TO      #CV-ADDRESS(1:2)
0071    MOVE (AD=I) TO      #CV-AREA-CODE
0072    MOVE (AD=I) TO     #CV-CITY
0073    MOVE (AD=I) TO      #CV-POSTAL-CODE
0074    MOVE (AD=I) TO      #CV-SURNAME
0075    MOVE (AD=I) TO     #CV-TELEPHONE
0076  END-IF
0077*
0078  INPUT USING MAP "ADDEM"
0079*************VALIDATION***************************
0080  IF #SURNAME = ' '
0081    REINPUT 'SURNAME MUST BE ENTERED' MARK *#SURNAME
0082  END-IF
0083  IF #ADDRESS(1) = ' '
0084    REINPUT 'PLEASE ENTER VALID ADDRESS' MARK  *#ADDRESS(1)
0085  END-IF
0086  IF #AREA-CODE = ' '
0087    REINPUT 'PLEASE ENTER VALID AREA COE' MARK *#AREA-CODE
0088  END-IF
0089  IF #CITY =  ' '
0090    REINPUT 'PLEASE ENTER A CITY' MARK *#CITY
0091  END-IF
0092  IF #POSTAL-CODE = ' '
0093    REINPUT 'PLEASE ENTER VALID POSTAL CODE' MARK *#POSTAL-CODE
0094  END-IF
0095  IF #TELEPHONE = ' '
0096    REINPUT 'INSERT TELEPHONE NUMBER' MARK *#TELEPHONE
0097  END-IF
0098******************* MOVE DATA BACK TO DATABASE****************
0099  MOVE #P-ID  TO PERSONNEL-ID
0100  MOVE #SURNAME       TO NAME
0101  MOVE #CITY          TO CITY
0102  MOVE #POSTAL-CODE   TO POST-CODE
0103  MOVE #ADDRESS(1:2)  TO ADDRESS-LINE(1:2)
0104  MOVE #COUNTRY       TO COUNTRY
0105  MOVE #AREA-CODE     TO AREA-CODE
0106  MOVE #TELEPHONE     TO PHONE
0107* 
0108
0109  MOVE (AD=P) TO      #CV-ADDRESS(1:2)
0110  MOVE (AD=P) TO      #CV-AREA-CODE
0111  MOVE (AD=P) TO      #CV-CITY
0112  MOVE (AD=P) TO      #CV-POSTAL-CODE
0113  MOVE (AD=P) TO      #CV-SURNAME
0114  MOVE (AD=P) TO      #CV-TELEPHONE
0115  UPDATE
0116*     END TRANSACTION
0117  INPUT WITH TEXT 'RECORD SUCCESSFULLY UPDATED' USING MAP "ADDEM"
0118*   END-IF
0119END-READ
0120*
0121END
