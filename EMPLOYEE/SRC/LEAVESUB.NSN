0001/** New Subprogram LEAVESUB.
0002/**
0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA PARAMETER
00061 #PERSONNEL-ID (A8)
0007******************************
0008LOCAL
00091 EMPLOYEES VIEW OF EMPLOYEES
0010  2 PERSONNEL-ID (A8)
0011  2 LEAVE-DUE (N2.0)
0012  2 LEAVE-TAKEN (N2.0)
0013  2 START (N8.0/1)
0014  2 END (N8.0/1)
0015  2 LEAVE-LEFT (B4)
0016*******************************
00171 #DAYS (N2)
00181 #DUE (N2)
00191 #END (A8)
00201 #LEFT (B4)
00211 #PERSON-ID (A8)
00221 #START (A8)
00231 #TAKEN (N2)
0024*******************************
00251 #INDEX (N3)
00261 #ISN (P10)
00271 #WEEKDAY (A10)
00281 #START-DATE (D)
00291 #END-DATE (D)
0030END-DEFINE
0031*
0032SET KEY 
0033  PF3 NAMED 'EXIT'
0034
0035FIND EMPLOYEES WITH PERSONNEL-ID = #PERSONNEL-ID
0036  MOVE  LEAVE-DUE      TO   #DUE
0037  MOVE  LEAVE-TAKEN    TO   #TAKEN
0038  MOVE  LEAVE-LEFT     TO   #LEFT
0039*   MOVE  START(*)       TO   #START
0040* MOVE  END(*)           TO   #END
0041END-FIND
0042*
0043INPUT USING MAP "LEAVEMAP"
0044*
0045IF *PF-KEY = 'PF3'
0046  ESCAPE ROUTINE
0047END-IF
0048*
0049IF #START = ' '
0050  REINPUT 'START DATE CANNOT BE BLANK'
0051    MARK *#START
0052END-IF
0053*
0054IF #END = ' '
0055  REINPUT 'START DATE CANNOT BE BLANK'
0056    MARK *#END
0057END-IF
0058*
0059MOVE EDITED #START TO #START-DATE (EM=YYYYMMDD)
0060MOVE EDITED #END TO #END-DATE (EM=YYYYMMDD)
0061
0062IF #START-DATE > #END-DATE
0063  REINPUT 'START DATE CANNOT BE AFTER END DATE'
0064    MARK *#START-DATE
0065END-IF
0066
0067IF #START-DATE < *DATX  OR #END-DATE < *DATX
0068  REINPUT "DATE CANNOT BE BEFORE TODAY'S DATE"
0069END-IF
0070
0071IF #START-DATE = #END-DATE
0072  MOVE 1 TO #DAYS
0073ELSE
0074  REPEAT
0075    IF #START-DATE = #END-DATE
0076      ESCAPE BOTTOM
0077    END-IF
0078    ADD 1 TO #START-DATE
0079    MOVE EDITED #START-DATE (EM=N(10))  TO #WEEKDAY
0080
0081    IF #WEEKDAY NE 'Saturday' OR #WEEKDAY NE 'Sunday'
0082      ADD 1 TO #DAYS
0083    END-IF
0084  END-REPEAT
0085END-IF
0086WRITE #START-DATE ',' #WEEKDAY 
0087  #END-DATE /
0088  'NUMBER OF LEAVE DAYS TAKEN'#DAYS
0089END
