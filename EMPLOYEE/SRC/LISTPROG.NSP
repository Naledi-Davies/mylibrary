0001/** New Program EMPPROG.
0002/**
0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 EMPLOYEES VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8)
0008  2 FIRST-NAME   (A20)
0009  2 NAME         (A20)
0010  2 CITY         (A20)
0011  2 JOB-TITLE (A25)
0012  2 DEPARTMENT (A4)
00131 RESTART-VALUE  (A20)
00141 SELECTION      (A1)
00151 #SELECT-INDEX  (N4)
00161 #LASTSEARCH    (A20)
00171 #INDEX         (N5)
00181 START-VALUE    (A20)
00191 #CITY          (A20/1:16)
00201 #FIRST-NAME    (A20/1:16)
00211 #NAME          (A20/1:16)
00221 #PERSONNEL-ID  (A8/1:16)
00231 #SELECTION     (A1/1:16)
00241 #SELECT (A1/1:4)
00251 #P-ID (A8)
00261 #ID (A8)
0027END-DEFINE
0028*
0029SET KEY
0030  PF3 NAMED  'EXIT'
0031  ENTR NAMED 'NEXT>>'
0032  PF5 NAMED 'ADD-E'
0033*
0034READ EMPLOYEES WITH REPOSITION
0035    BY NAME STARTING FROM START-VALUE
0036*
0037  ADD 1 TO #INDEX
0038*
0039  MOVE PERSONNEL-ID TO #PERSONNEL-ID(#INDEX)
0040  MOVE FIRST-NAME   TO #FIRST-NAME(#INDEX)
0041  MOVE NAME         TO #NAME (#INDEX)
0042  MOVE CITY         TO #CITY(#INDEX)
0043  MOVE SELECTION    TO #SELECTION(#INDEX)
0044*
0045  IF #INDEX=16
0046    INPUT USING MAP "LISTMAP"
0047*
0048    IF *PF-KEY = 'PF3'
0049      FETCH 'MAINPROG'
0050    END-IF
0051*
0052    IF *PF-KEY = 'PF5'
0053      CALLNAT "ADDEMPL" #P-ID
0054    END-IF
0055* 
0056    FOR #SELECT-INDEX = 1 TO 16
0057      IF #SELECTION (#SELECT-INDEX) EQ 'U'
0058        CALLNAT "UPDEMPL" #PERSONNEL-ID(#SELECT-INDEX)
0059      END-IF
0060*
0061      IF #SELECTION (#SELECT-INDEX) EQ 'M'
0062        CALLNAT "MARSUB" #PERSONNEL-ID(#SELECT-INDEX)
0063      END-IF
0064      IF #SELECTION (#SELECT-INDEX) EQ 'C'
0065        CALLNAT "COMSUB" #PERSONNEL-ID(#SELECT-INDEX)
0066      END-IF
0067*
0068      IF #SELECTION (#SELECT-INDEX) EQ 'L'
0069        CALLNAT "LEAVESUB" #PERSONNEL-ID(#SELECT-INDEX)
0070      END-IF
0071    END-FOR
0072    IF RESTART-VALUE NE ' '
0073      MOVE RESTART-VALUE TO START-VALUE #LASTSEARCH
0074      RESET RESTART-VALUE
0075      RESET #INDEX
0076      ESCAPE TOP REPOSITION
0077    END-IF
0078    RESET
0079      #INDEX
0080      #PERSONNEL-ID(*)
0081      #FIRST-NAME(*)
0082      #NAME(*)
0083      #CITY(*)
0084  END-IF
0085*
0086END-READ
0087*
0088IF #INDEX < 16
0089  RESET #PERSONNEL-ID(#INDEX+1:16)
0090    #NAME(#INDEX+1:16)
0091    #CITY(#INDEX+1:16)
0092  INPUT USING MAP "LISTMAP"
0093END-IF
0094*
0095END
