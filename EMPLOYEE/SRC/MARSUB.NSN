0001/** New Subprogram ADDEMP.
0002/**
0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA PARAMETER
00061 #PERSONNEL-ID  (A8)
0007LOCAL 
00081 EMPLOYEE VIEW OF EMPLOYEES
0009  2 PERSONNEL-ID (A8)
0010  2 FIRST-NAME (A20)
0011  2 NAME (A20)
0012  2 MAR-STAT (A1)
0013  2 GENDER (A1)
0014  2 LANG (A3/1:5)
0015******************************************
00161 #CV-F-NAME (C)
00171 #CV-GENDER (C)
00181 #CV-LANG (C/1:5)
00191 #CV-MARSTAT (C)
00201 #CV-S-NAME (C)
00211 #F-NAME (A20)
00221 #GENDER (A1)
00231 #GENDER-DESCRIPION (A10)
00241 #LANGUAGES (A3/1:5)
00251 #MAR-STAT (A1)
00261 #MAR-STAT-DESCRIPTION (A10)
00271 #PERSON-ID (A8)
00281 #PROGRAM (A8)
00291 #SURNAME (A20)
0030END-DEFINE
0031*
0032SET KEY
0033  PF4 NAMED 'UPDATE'
0034*
0035MOVE (AD=P) TO   #CV-F-NAME
0036MOVE (AD=P) TO   #CV-GENDER
0037MOVE (AD=P) TO   #CV-LANG(1:5)
0038MOVE (AD=P) TO   #CV-MARSTAT
0039MOVE (AD=P) TO   #CV-S-NAME 
0040*
0041FIND EMPLOYEE WITH PERSONNEL-ID = #PERSONNEL-ID
0042*
0043  MOVE #PERSONNEL-ID TO #PERSON-ID
0044  MOVE NAME          TO #SURNAME
0045  MOVE FIRST-NAME    TO #F-NAME
0046  MOVE MAR-STAT      TO #MAR-STAT
0047  MOVE GENDER        TO #GENDER
0048  MOVE LANG (1:5)    TO #LANGUAGES(1:5)
0049*
0050  DECIDE ON FIRST VALUE OF #GENDER
0051    VALUE 'M'
0052MOVE 'MALE' TO #GENDER-DESCRIPION /* THE MOVE STATEMENT IS MOST EFFECTIVE TO TRANSFER DATA FROM ONE FIELD TO ANOTHER
0053    VALUE 'F'
0054      MOVE 'FEMALE' TO #GENDER-DESCRIPION
0055    NONE VALUE
0056      MOVE 'UNKNOWN' TO #GENDER-DESCRIPION
0057  END-DECIDE
0058*
0059  DECIDE ON FIRST VALUE OF #MAR-STAT
0060    VALUE 'S'
0061MOVE 'SINGLE' TO #MAR-STAT-DESCRIPTION /* THE MOVE STATEMENT IS MOST EFFECTIVE TO TRANSFER DATA FROM ONE FIELD TO ANOTHER
0062    VALUE 'M'
0063      MOVE 'MARRIED' TO #MAR-STAT-DESCRIPTION
0064    VALUE 'D'
0065      MOVE 'DIVORCED' TO #MAR-STAT-DESCRIPTION
0066    VALUE 'W'
0067      MOVE 'WIDOWED' TO #MAR-STAT-DESCRIPTION
0068    NONE VALUE
0069      MOVE 'UNKNOWN' TO #MAR-STAT-DESCRIPTION
0070  END-DECIDE
0071*
0072  INPUT USING MAP "MARMAP"
0073*
0074  IF *PF-KEY = 'PF4'
0075*
0076    MOVE (AD=I) TO
0077      #CV-F-NAME
0078      #CV-LANG (1:5)
0079      #CV-S-NAME
0080      #CV-GENDER
0081      #CV-MARSTAT
0082*
0083    INPUT USING MAP "MARMAP"
0084* END-IF
0085*
0086
0087*************VALIDATION***************************
0088    IF #SURNAME = ' '
0089      REINPUT 'SURNAME MUST BE ENTERED' MARK *#SURNAME
0090    END-IF
0091    IF #F-NAME = ' '
0092      REINPUT 'NAME MUST BE ENTERED' MARK  *#F-NAME
0093    END-IF
0094    IF NOT (#MAR-STAT = 'W' OR
0095        #MAR-STAT = 'M' OR
0096        #MAR-STAT = 'S' OR
0097        #MAR-STAT = 'D')
0098      REINPUT 'INVALID MARITAL STATUS' MARK *#MAR-STAT
0099    END-IF
0100    IF NOT  (#GENDER = 'F' OR
0101        #GENDER = 'M' )
0102      REINPUT 'INVALID GENDER' MARK *#GENDER
0103    END-IF
0104    IF #LANGUAGES(1) = ' '
0105      REINPUT 'ADD AT LEAST ADD ONE LANGUAGE SPOKEN' MARK *#LANGUAGES(1)
0106    END-IF
0107******************* MOVE DATA BACK TO DATABASE****************
0108    MOVE #F-NAME          TO FIRST-NAME
0109    MOVE #SURNAME         TO NAME
0110    MOVE #MAR-STAT        TO MAR-STAT
0111    MOVE #GENDER          TO GENDER
0112    MOVE #LANGUAGES (1:5) TO LANG (1:5)
0113    MOVE #PERSON-ID       TO #PERSONNEL-ID
0114*
0115    MOVE (AD=P) TO
0116      #CV-F-NAME
0117      #CV-LANG (1:5)
0118      #CV-S-NAME
0119      #CV-GENDER
0120*       #CV-MARSTAT
0121*     UPDATE
0122*     END TRANSACTION
0123    INPUT WITH TEXT 'RECORD SUCCESSFULLY UPDATED' USING MAP 'MARMAP'
0124*
0125  END-IF
0126END-FIND
0127*
0128END
