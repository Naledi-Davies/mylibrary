0005DEFINE DATA PARAMETER
00061 #XML_SERIALZE_OUTPUT (A) DYNAMIC
0007PARAMETER USING XMLPDA 
0008END-DEFINE
0009IF #XML_SERIALZE_OUTPUT = SCAN 'xml version='
0010  IGNORE
0011ELSE
0012  COMPRESS        '<?xml version="1.0" encoding="' *CODEPAGE '"?>'
0013    INTO #XML_SERIALZE_OUTPUT LEAVING NO
0014  COMPRESS #XML_SERIALZE_OUTPUT
0015    '<EMP>' INTO #XML_SERIALZE_OUTPUT LEAVING NO
0016END-IF
0017*
0018COMPRESS #XML_SERIALZE_OUTPUT
0019  '<PERSONNEL-ID>' INTO #XML_SERIALZE_OUTPUT LEAVING NO
0020COMPRESS #XML_SERIALZE_OUTPUT
0021  EMP.PERSONNEL-ID
0022  '</PERSONNEL-ID>' INTO #XML_SERIALZE_OUTPUT LEAVING NO
0023
0024COMPRESS #XML_SERIALZE_OUTPUT
0025  '<NAME>' INTO #XML_SERIALZE_OUTPUT LEAVING NO
0026COMPRESS #XML_SERIALZE_OUTPUT
0027  EMP.GENDER
0028  '</NAME>' INTO #XML_SERIALZE_OUTPUT LEAVING NO
0029COMPRESS #XML_SERIALZE_OUTPUT
0030  '<GENDER>' INTO #XML_SERIALZE_OUTPUT LEAVING NO
0031COMPRESS #XML_SERIALZE_OUTPUT
0032  EMP.GENDER
0033  '</GENDER>' INTO #XML_SERIALZE_OUTPUT LEAVING NO
0034COMPRESS #XML_SERIALZE_OUTPUT
0035  '<MAR-STAT>' INTO #XML_SERIALZE_OUTPUT LEAVING NO
0036COMPRESS #XML_SERIALZE_OUTPUT
0037  EMP.MAR-STAT
0038  '</MAR-STAT>' INTO #XML_SERIALZE_OUTPUT LEAVING NO
0039COMPRESS #XML_SERIALZE_OUTPUT
0040  '<CITY>' INTO #XML_SERIALZE_OUTPUT LEAVING NO
0041COMPRESS #XML_SERIALZE_OUTPUT
0042  EMP.CITY
0043  '</CITY>' INTO #XML_SERIALZE_OUTPUT LEAVING NO
0044COMPRESS #XML_SERIALZE_OUTPUT
0045  '<COUNTRY>' INTO #XML_SERIALZE_OUTPUT LEAVING NO
0046COMPRESS #XML_SERIALZE_OUTPUT
0047  EMP.COUNTRY
0048  '</COUNTRY>' INTO #XML_SERIALZE_OUTPUT LEAVING NO
0049END
