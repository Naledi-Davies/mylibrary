0001/** New Program WRK41.
0002/**
0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL 
00061 EMPLOYEES-DDM VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8)
0008  2 NAME (A20)
0009  2 CITY (A20)
00101 RESTART-VALUE (A20)
00111 SELECTION (A1)
0012*****************************************
00131 #CITY (A20/1:16)
00141 #NAME (A20/1:16)
00151 #PERSONNEL-ID (A8/1:16)
00161 #SELECTION (A1/1:16)
00171 #INDEX (N3)
00181 EXIT (A9)
00191 #SELECT-INDEX (N3)
00201 START-VALUE (A20)
0021**************************************
00221 #LASTSEARCH (A20)
0023END-DEFINE
0024* 
0025SET KEY
0026  PF3 NAMED 'EXIT'
0027  ENTR NAMED 'NEXT>>' 
0028*
0029READ EMPLOYEES-DDM WITH REPOSITION
0030    BY NAME STARTING FROM START-VALUE
0031  /**     STARTING FROM RESTART-VALUE
0032*
0033  ADD 1 TO #INDEX
0034*
0035  MOVE PERSONNEL-ID TO #PERSONNEL-ID(#INDEX)
0036  MOVE NAME         TO #NAME (#INDEX)
0037  MOVE CITY         TO #CITY(#INDEX)
0038  MOVE SELECTION    TO #SELECTION(#INDEX)
0039
0040* 
0041  IF #INDEX=16
0042    INPUT USING MAP "WRK41MAP"
0043    IF RESTART-VALUE NE ' '
0044      MOVE RESTART-VALUE TO START-VALUE #LASTSEARCH
0045      RESET RESTART-VALUE
0046      RESET #INDEX
0047      ESCAPE TOP REPOSITION
0048    END-IF
0049*
0050    IF *PF-KEY = 'PF3'
0051      ESCAPE BOTTOM
0052    END-IF
0053*
0054    RESET #INDEX
0055    FOR #SELECT-INDEX = 1 TO 16
0056      IF #SELECTION (#SELECT-INDEX) EQ 'A'
0057        CALLNAT "WRK41-2S" #PERSONNEL-ID(#SELECT-INDEX)
0058*         RESET #SELECTION(#SELECT-INDEX)
0059      END-IF
0060    END-FOR    
0061  END-IF
0062END-READ
0063IF #INDEX < 16
0064  RESET #PERSONNEL-ID(#INDEX+1:16)
0065    #NAME(#INDEX+1:16)
0066    #CITY(#INDEX+1:16)
0067  INPUT USING MAP "WRK41MAP"
0068END-IF
0069*
0070END
