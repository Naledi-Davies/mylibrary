0001/** New Helproutine WK36HR.
0002/**
0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA
0006PARAMETER
00071 #MARITAL-STATUS-DESCRIPTION (A20)
00081 #MARITAL-STATUS (A1) 
0009LOCAL
00101 #SELECT (A1/1:4)
00111 #INDEX (N1)
0012END-DEFINE
0013*
0014INPUT USING MAP "WK36HELP"
0015*
0016IF *PF-KEY = 'PF3'
0017  ESCAPE MODULE
0018END-IF
0019* 
0020DECIDE FOR FIRST CONDITION
0021  WHEN #SELECT(1) NE ' '
0022    MOVE 'W' TO #MARITAL-STATUS
0023    MOVE 'WIDOWED' TO #MARITAL-STATUS-DESCRIPTION
0024
0025  WHEN #SELECT(2) NE ' '
0026    MOVE 'S' TO #MARITAL-STATUS
0027    MOVE 'SINGLE' TO #MARITAL-STATUS-DESCRIPTION
0028    
0029  WHEN #SELECT(3) NE ' '
0030    MOVE 'D' TO #MARITAL-STATUS
0031    MOVE ' DIVORCED' TO #MARITAL-STATUS-DESCRIPTION
0032        
0033  WHEN #SELECT(4) NE ' '
0034    MOVE 'M' TO #MARITAL-STATUS
0035    MOVE 'MARRIED' TO #MARITAL-STATUS-DESCRIPTION
0036    
0037  WHEN  NONE
0038    REINPUT ' Please select one option with "X"'
0039*
0040END-DECIDE
0041END
0042 
