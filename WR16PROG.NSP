0004/* TODO Enter your code here
0005* DEFINE DATA LOCAL
0006* 1 EMPLOYEE VIEW OF EMPLOYEES
0007*   2 PERSONNEL-ID (A8)
0008*   2 NAME (A20)
0009*   2 GENGER (A1)
0010*   2 CITY (A20)
0011* 1 #EXIT (A9)
0012* 1 #INDEX (I1)
0013* 1 ##PERSONNEL-ID (A8/1:16)
0014* 1 ##NAME (A20/1:16)
0015* 1 ##GENGER (A1/1:16)
0016* 1 ##CITY (A20/1:16)
0017* END-DEFINE 
0018* * 
0019*      SET KEY/** %Y=GRPIYE
0020*    PF3 NAMED 'EXIT'
0021*   ENTR NAMED 'NEXT>>'
0022* *
0023* FORMAT LS=100
0024* *
0025* READ (23) EMPLOYEE BY PERSONNEL-ID
0026* *
0027*   ADD 1 TO #INDEX
0028* *
0029*   MOVE PERSONNEL-ID TO ##PERSONNEL-ID(#INDEX)
0030*   MOVE NAME         TO ##NAME (#INDEX)
0031*   MOVE GENGER       TO ##GENGER (#INDEX)
0032*   MOVE CITY         TO ##CITY(#INDEX)
0033* *
0034* *   IF '#EXIT' = 'Q'
0035* *     ESCAPE BOTTOM
0036* *   END-IF
0037*   IF #INDEX = 16
0038* *   RESET ##NAME(#INDEX+1:16) 
0039*     INPUT USING MAP "WRK16PRO"
0040*     RESET #INDEX
0041*   END-IF
0042* END-READ
0043* IF #INDEX < 16
0044*   RESET ##PERSONNEL-ID(#INDEX+1:16)
0045*     ##NAME(#INDEX+1:16)
0046*     ##GENGER(#INDEX+1:16)
0047*     ##CITY(#INDEX+1:16) 
0048*     INPUT USING MAP "WRK16PRO"
0049*     
0050* 
0051* END-IF
0052END
