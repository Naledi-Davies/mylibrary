0005DEFINE DATA LOCAL 
00061 EMPLOYEES VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8)
0008  2 NAME (A20)
0009  2 CITY (A20)
0010  2 COUNTRY (A3)
0011  2 LANG (A3/1:5)
00121 #COUNT (N3)
0013END-DEFINE
0014*
0015FORMAT LS = 80
0016FORMAT PS = 20
0017*
0018WRITE TITLE LEFT JUSTIFIED UNDERLINED                                   
00191T'PROGRAM:'10T'WS66REP' 24T 'SAG INTERNS EMPLOYEE SYSTEM' 63T 'PAGE:'  *PAGE-NUMBER /
00201T'DATE:'7T *DATX (EM=DD.MM.YYYY) 23T  'LANGUAGES SPOKEN PER EMPLOYEE' 63T'TIME:'*TIME
0021  /  30T'DEPARTMENT:SALE20' 
0022  '-' (79)
0023  /'PERS ID'10T'NAME'31T'CITY'52T'CNTY'57T'LANG'
0024*
0025WRITE TRAILER LEFT JUSTIFIED UNDERLINED                                 
0026  ' '
0027*
0028F1. FIND EMPLOYEES WITH DEPT = 'SALE20'                                   
0029  WRITE
0030    PERSONNEL-ID
0031    NAME
0032    CITY
0033    COUNTRY 2X
0034    LANG(*)
0035  AT END OF DATA
0036    WRITE '*'(79)
0037    WRITE 'EMPLOYEES FOUND' COUNT(F1.)(EMPLOYEES.PERSONNEL-ID)/
0038      'END OF REPORT'
0039    WRITE '*'(79)
0040  END-ENDDATA
0041END-FIND                             
0042END
