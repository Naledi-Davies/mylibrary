0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 EMPLOYEE-DDM VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8)
0008  2 NAME (A20)
0009  2 CITY (A20)
0010  2 DEPT (A6)
0011  2 GENDER (A1)
0012  2 INCOME (1:3)
0013    3 CURR-CODE (A3)
0014    3 SALARY (P9)
0015    3 BONUS (P9/1:3)
0016  2 DEPARTMENT (A4)
0017END-DEFINE
0018FORMAT LS= 250
0019F1. FIND EMPLOYEE-DDM WITH
0020DEPARTMENT EQ 'SALE' SORTED BY PERSONNEL-ID NAME CITY WHERE DEPT EQ 'SALE20' AND GENDER EQ 'F'
0021*
0022  AT START OF DATA
0023    WRITE 'NUMBER OF RECORDS FOUND:' *NUMBER(F1.)
0024  END-START
0025*
0026  DISPLAY
0027*      
0028    EMPLOYEE-DDM.PERSONNEL-ID
0029    EMPLOYEE-DDM.NAME (AL=10)
0030    EMPLOYEE-DDM.CITY
0031    EMPLOYEE-DDM.DEPT
0032    EMPLOYEE-DDM.GENDER
0033*     EMPLOYEE-DDM.INCOME(1)
0034* *     EMPLOYEE-DDM.CURR-CODE (1)
0035* *     EMPLOYEE-DDM.SALARY(1)
0036* *     EMPLOYEE-DDM.BONUS (1,*)
0037    *COUNTER(F1.)
0038*     *ISN
0039*
0040  AT END OF DATA
0041    WRITE 'NUMBER OF RECORDS FOUND'
0042      *NUMBER(F1.)
0043*       COUNT(F1.)(EMPLOYEE-DDM.PERSONNEL-ID)
0044  END-ENDDATA
0045*   WRITE 
0046*   CURR-CODE (1) SALARY (1) BONUS (1,1) BONUS (1,2) BONUS (1,3)
0047*   WRITE CURR-CODE (2) SALARY (2) BONUS (2,1) BONUS (2,2) BONUS (2,3)
0048*   WRITE CURR-CODE (3) SALARY (3) BONUS (3,1) BONUS (3,2) BONUS (3,3)
0049*
0050END-FIND
0051
0052END
