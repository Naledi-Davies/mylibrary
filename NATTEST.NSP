0001/** New Program NATTEST.
0002/**
0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 TEST-DATA (A100)
00071 #COUNT-EMAIL (N5)
00081 #POS (N2) 
00091 #NUMBER (N5) 
00101 #COUNT-NUMBERS (N5) 
00111 #COUNT-SENTENCES (N5)
00121 #COUNT-S-WORDS (N5)
00131 #COUNT (N5)
0014END-DEFINE
0015*
0016DEFINE WORK FILE 1 'C:\TRAINING\TEST-DATA.TXT'
0017DEFINE WORK FILE 2 'C:\TRAINING\EMAILS@.TXT'
0018DEFINE WORK FILE 3 'C:\TRAINING\NUMBERS123.TXT'
0019DEFINE WORK FILE 4 'C:\TRAINING\SENTENCES.TXT'
0020DEFINE WORK FILE 5 'C:\TRAINING\SINGLEWORDS.TXT'
0021DEFINE WORK FILE 6 'C:\TRAINING\COUNT.TXT'
0022*
0023**********EMAIL**********
0024READ WORK FILE 1 TEST-DATA
0025*
0026ADD 1 TO #COUNT
0027*
0028  EXAMINE TEST-DATA FOR '@' GIVING POSITION #POS
0029*
0030  IF #POS > 0
0031    WRITE WORK FILE 2 TEST-DATA
0032    ADD 1 TO #COUNT-EMAIL
0033    ESCAPE TOP
0034  END-IF
0035*
0036
0037********* NUMBERS *********
0038* 
0039  IF 
0040*      
0041      SUBSTRING(TEST-DATA,1,1) EQ '0' THRU '9'
0042    WRITE WORK FILE 3 TEST-DATA
0043    ADD 1 TO #COUNT-NUMBERS
0044    ESCAPE TOP
0045  END-IF
0046*
0047********SENTENCES********
0048* sentences start in upper case
0049  IF
0050      SUBSTRING(TEST-DATA,1,1) EQ 'A' THRU 'Z'
0051    WRITE WORK FILE 4 TEST-DATA
0052    ADD 1 TO #COUNT-SENTENCES
0053    ESCAPE TOP
0054  END-IF
0055*
0056*******SINGLE WORDS*******
0057*  
0058  IF
0059      SUBSTRING(TEST-DATA,1,1) NE '  '
0060    WRITE WORK FILE 5 TEST-DATA
0061    ADD 1 TO #COUNT-S-WORDS
0062    ESCAPE TOP
0063  END-IF
0064
0065*
0066END-WORK
0067*
0068WRITE WORK FILE 6'TOTAL OF EMAILS           :   ' #COUNT-EMAIL
0069WRITE WORK FILE 6'TOTAL OF NUMRICS          :   ' #COUNT-NUMBERS
0070WRITE WORK FILE 6'TOTAL OF SENTENCES        :   ' #COUNT-SENTENCES
0071WRITE WORK FILE 6'TOTAL OF SINGLE WORDS     :   ' #COUNT-S-WORDS
0072WRITE WORK FILE 6'TOTAL OF ENTIRE TEXT FILE :   ' #COUNT
0073END
