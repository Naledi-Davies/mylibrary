0140WRITE WORK FILE 1
0141  'NONE OF THE ABOVE:    ' #MAR-STATSNONE
0142*
0143WRITE WORK FILE 1
0144  'SALARY: 0-4999        '       #SALARY1
0145WRITE WORK FILE 1
0146  'SALARY: 5000-999      '       #SALARY2
0147WRITE WORK FILE 1
