0005DEFINE DATA LOCAL
0006*
00071 EMPLOYEE VIEW OF EMPLOYEES
0008*
0009  2 PERSONNEL-ID (A8)
0010  2 REDEFINE PERSONNEL-ID
0011    3 COUNTRY-CODE (N1)
0012  2 MAR-STAT (A1)
0013  2 GENDER (A1)
0014  2 SALARY (P9.0/1:1)
0015* ********************************************************************
00161 #MAR-STATS (N3)
00171 #MAR-STATD (N3)
00181 #MAR-STATM (N3)
00191 #MAR-STATW (N3)
00201 #MAR-STATEMPTY (N3)
00211 #MAR-STATSNONE (N3)
0022* ********************************************************************
00231 #GENGER-FEMALE (N3)
00241 #GENGER-MALE (N3)
00251 #GENGER-EMPTY (N3)
00261 #GENGER-NONE (N3)
0027* ********************************************************************
00281 #SALARY1 (N3)
00291 #SALARY2 (N3)
00301 #SALARY3 (N3)
00311 #SALARY4 (N3)
00321 #SALARY5 (N3)
0033* *********************************************************************
00341 #COUNTRY-CODE1 (N3)
00351 #COUNTRY-CODE2 (N3)
00361 #COUNTRY-CODE3 (N3)
00371 #COUNTRY-CODE4 (N3)
00381 #COUNTRY-CODE5 (N3)
00391 #COUNTRY-CODE6 (N3)
0040*
0041END-DEFINE 
0042*
0043FORMAT LS=245
0044FORMAT PS=23
0045*
0046DEFINE WORK FILE 1
0047  'C:\TRAINING\SUMMARY.TXT'
0048*
0049R1. READ EMPLOYEE
0050*
0051* GENDER
0052  DECIDE ON FIRST MAR-STAT
0053    VALUE 'F'
0054
0055      ADD 1 TO #GENGER-FEMALE
0056    VALUE 'M'
0057      ADD 1 TO #GENGER-MALE
0058    VALUE ' '
0059      ADD 1 TO #GENGER-EMPTY
0060    NONE
0061      ADD 1 TO #GENGER-NONE
0062      IGNORE
0063  END-DECIDE
0064*
0065* MARITAL STATUS
0066  DECIDE ON FIRST MAR-STAT
0067    VALUE 'S'
0068      ADD 1 TO #MAR-STATS
0069    VALUE 'D'
0070      ADD 1 TO #MAR-STATD
0071    VALUE 'W'
0072      ADD 1 TO #MAR-STATW
0073    VALUE ' '
0074      ADD 1 TO #MAR-STATEMPTY
0075    NONE
0076      ADD 1 TO #MAR-STATSNONE
0077      IGNORE
0078  END-DECIDE
0079*
0080* SALARY
0081  DECIDE ON FIRST SALARY(1)
0082    VALUE 0:4999
0083      ADD 1 TO #SALARY1
0084    VALUE 5000:9999
0085      ADD 1 TO #SALARY2
0086    VALUE 10000:14999
0087      ADD 1 TO #SALARY3
0088    VALUE 15000:19999
0089      ADD 1 TO #SALARY4
0090    VALUE 20000:100000
0091      ADD 1 TO #SALARY5
0092    NONE
0093      IGNORE
0094  END-DECIDE
0095*
0096* COUNTRIES
0097  DECIDE ON FIRST PERSONNEL-ID
0098    VALUE '1':'19999999'
0099      ADD 1 TO #COUNTRY-CODE1
0100*  
0101    VALUE '2':'29999999'
0102      ADD 1 TO #COUNTRY-CODE2
0103*
0104    VALUE '3':'39999999'
0105      ADD 1 TO #COUNTRY-CODE3
0106* 
0107    VALUE '4':'49999999'
0108      ADD 1 TO #COUNTRY-CODE4
0109* 
0110    VALUE '5':'59999999'
0111      ADD 1 TO #COUNTRY-CODE5
0112*     
0113    VALUE '6':'69999999'
0114      ADD 1 TO #COUNTRY-CODE6
0115*
0116    NONE
0117      IGNORE
0118  END-DECIDE
0119*
0120END-READ
0121WRITE WORK FILE 1
0122  'FEMALE:               ' #GENGER-FEMALE
0123WRITE WORK FILE 1
0124  'MALE:                 '   #GENGER-MALE
0125WRITE WORK FILE 1
0126  'EMPTY:                '  #GENGER-EMPTY
0127WRITE WORK FILE 1
0128  'NONE OF THE ABOVE:    '   #GENGER-NONE
0129*
0130WRITE WORK FILE 1
