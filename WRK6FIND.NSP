0001/** New Program WRK6FIND.
0002/**
0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 EMPLOYEES-DDM VIEW EMPLOYEES
0007  2 PERSONNEL-ID (A8)
0008  2 NAME (A20)
0009  2 CITY (A20)
0010END-DEFINE
0011*
0012FORMAT LS=248
0013*
0014F1. FIND EMPLOYEES-DDM WITH                                                                             
0015    EMPLOYEES-DDM.CITY EQ 'DERBY'
0016*
0017  IF NO RECORD FOUND
0018    WRITE
0019      'NO RECORDS FOUND'
0020    ESCAPE BOTTOM (F1.)
0021  END-NOREC
0022*
0023  DISPLAY *ISN
0024    EMPLOYEES-DDM.PERSONNEL-ID
0025    EMPLOYEES-DDM.NAME (AL=10)
0026    EMPLOYEES-DDM.CITY (AL=10)
0027    'NUMBER:' *NUMBER
0028    'COUNTER:'*COUNTER
0029END-FIND
0030END
