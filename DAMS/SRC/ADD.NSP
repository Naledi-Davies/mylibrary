0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 DAMSA VIEW OF DAMSA
0007  2 DAM-ID           (A5)
0008  2 NAME-DAM         (A50)
0009  2 LOCALE           (A50)
0010  2 PROVINCE         (A50)
0011  2 IMPOUNDS         (A50)
0012  2 ALT-NAMES        (A50)
0013  2 YEAR-COMPLETED   (N4.0)
0014  2 RESEVOIR-VOL     (N10.0)
0015  2 SURFACE-AREA     (N3.3)
0016  2 WALL-HEIGHT      (N4.3)
0017*
00181 #ALT-INFO          (A50)
00191 #DAM-ID            (A5)
00201 REDEFINE #DAM-ID
0021  2 #DAMID           (N5)
00221 #DAM-NAME          (A40)
00231 #IMPOUND           (A15)
00241 #LOCALE            (A15)
00251 #PROVINCE          (A20)
00261 #RES-VOL           (N10)
00271 #SURF-AREA         (N3.3)
00281 #WALL-HEIGHT       (N4.3)
00291 #YEAR-COMPLETED    (N4)
0030*
00311 #CV-ALT (C)
00321 #CV-DAM-ID (C)
00331 #CV-DAM-NAME (C)
00341 #CV-IMPOUND (C)
00351 #CV-LOCALE (C)
00361 #CV-PROVINCE (C)
00371 #CV-RES-VOL (C)
00381 #CV-SURF-AREA (C)
00391 #CV-WALL-HEIGHT (C)
00401 #CV-YEAR-COMPLETED (C)
0041END-DEFINE
0042*
0043SET KEY
0044  PF3 NAMED 'EXIT'
0045* GET LAST DAM ID
0046READ (1) DAMSA DESCENDING BY DAM-ID
0047  MOVE DAM-ID TO #DAM-ID
0048  ADD 1 TO #DAMID
0049  ESCAPE BOTTOM
0050END-READ
0051*
0052REPEAT
0053*
0054  INPUT USING MAP 'ADDMAP'
0055*
0056  IF *PF-KEY = 'PF3'
0057    ESCAPE MODULE
0058  END-IF
0059
0060* VALIDATION 
0061  IF #DAM-NAME = ' '
0062    REINPUT 'ENTER THE DAM NAME'
0063      MARK *#DAM-NAME
0064  END-IF
0065*
0066  IF #IMPOUND = ' '
0067    REINPUT 'ENTER IMPOUND INFORMATION'
0068      MARK *#IMPOUND
0069  END-IF
0070*
0071  IF #LOCALE = ' '
0072    REINPUT 'ENTER LOCALE INFORMATION'
0073      MARK *#LOCALE
0074  END-IF
0075*
0076  IF #PROVINCE = ' '
0077    REINPUT 'ENTER PROVINCE INFORMATION'
0078      MARK *#PROVINCE
0079  END-IF
0080*
0081  IF #RES-VOL = 0
0082    REINPUT 'ENTER RESERVOIR VOLUME'
0083      MARK *#RES-VOL
0084  END-IF
0085*
0086  IF #SURF-AREA = 0
0087    REINPUT 'ENTER SURFACE AREA'
0088      MARK *#SURF-AREA
0089  END-IF
0090*
0091  IF #WALL-HEIGHT = 0
0092    REINPUT 'ENTER WALL HEIGHT'
0093      MARK *#WALL-HEIGHT
0094  END-IF
0095*
0096  IF #YEAR-COMPLETED = 0
0097    REINPUT 'ENTER YEAR COMPLETED'
0098      MARK *#YEAR-COMPLETED
0099  END-IF
0100*
0101  ESCAPE BOTTOM
0102*
0103END-REPEAT
0104* MOVE SCREEN FIELDS TO DATABASE FIELDS 
0105NAME-DAM       := #DAM-NAME
0106IMPOUNDS       := #IMPOUND
0107LOCALE         := #LOCALE
0108PROVINCE       := #PROVINCE
0109ALT-NAMES      := #ALT-INFO
0110RESEVOIR-VOL   := #RES-VOL
0111SURFACE-AREA   := #SURF-AREA
0112WALL-HEIGHT    := #WALL-HEIGHT
0113YEAR-COMPLETED := #YEAR-COMPLETED
0114* STORE NEW RECORD                               
0115STORE DAMSA
0116* END TRANSACTION
0117*
0118WRITE 'NEW DAM CREATED SUCCESSFULLY'
0119WRITE 'NEW DAM ID:' DAM-ID
0120*
0121* END-REPEAT
0122END
