0001/** New Helproutine MENUHR.
0002/**
0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA
0006PARAMETER
00071 #SELECTED (A1)
0008LOCAL
00091 #SELECT-HELP (A1/1:3)
00101 #INDEX (N1)
0011END-DEFINE
0012*
0013INPUT USING MAP "MENUHELP"
0014*
0015SET CONTROL 'MT'
0016IF *PF-KEY = 'PF3'
0017  ESCAPE MODULE
0018END-IF
0019* 
0020DECIDE FOR EVERY CONDITION
0021  WHEN #SELECT-HELP(1) NE ' '
0022    MOVE 'L' TO #SELECTED
0023*
0024  WHEN #SELECT-HELP(2) NE ' '
0025    MOVE 'S' TO #SELECTED
0026*    
0027  WHEN #SELECT-HELP(3) NE ' '
0028    MOVE 'A' TO #SELECTED
0029* 
0030  WHEN  NONE
0031    REINPUT 'Please select "L" OR "S" OR "A"'
0032*
0033END-DECIDE
0034END
0035
