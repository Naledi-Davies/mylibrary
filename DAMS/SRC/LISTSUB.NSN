0015/** :author tda
0016/* TODO Enter your code here
0017DEFINE DATA PARAMETER
00181 #DAM-ID (A5)
0019LOCAL 
0020/*( imported data fields from Data Definition Module DAM-DATABASE
00211 DAMSA VIEW OF DAMSA
0022  2 DAM-ID (A5)
0023  2 NAME-DAM (A50)
0024  2 LOCALE (A50)
0025  2 PROVINCE (A50)
0026  2 IMPOUNDS (A50)
0027  2 ALT-NAMES (A50)
0028  2 YEAR-COMPLETED (N4.0)
0029  2 RESEVOIR-VOL (N10.0)
0030  2 SURFACE-AREA (N3.3)
0031  2 WALL-HEIGHT (N4.3)
0032*************cv-fields*******************  
00331 #CV-NAME-DAM (C)
00341 #CV-SURFACE-AREA (C)
00351 #CV-RESEVOIR-VOL (C)
00361 #CV-YEAR-COMPLETED (C)
00371 #CV-IMPOUNDS (C)
00381 #CV-LOCALE (C)
00391 #CV-PROVINCE (C)
00401 #CV-WALL-HEIGHT (C)
0041END-DEFINE
0042*
0043SET CONTROL 'MT'
0044*
0045SET KEY
0046  PF4 NAMED 'UPDATE'
0047*
0048MOVE (AD=P) TO   #CV-NAME-DAM
0049MOVE (AD=P) TO   #CV-RESEVOIR-VOL
0050MOVE (AD=P) TO   #CV-SURFACE-AREA 
0051MOVE (AD=P) TO   #CV-WALL-HEIGHT
0052MOVE (AD=P) TO   #CV-YEAR-COMPLETED 
0053MOVE (AD=P) TO   #CV-IMPOUNDS 
0054MOVE (AD=P) TO   #CV-LOCALE 
0055MOVE (AD=P) TO   #CV-PROVINCE
0056*
0057FIND DAMSA WITH DAM-ID = #DAM-ID
0058*
0059*   MOVE PERSONNEL-ID      TO #PERSON-ID
0060*   MOVE NAME              TO #SURNAME
0061*   MOVE CITY              TO #CITY
0062*   MOVE POST-CODE         TO #POSTAL-CODE
0063*   MOVE ADDRESS-LINE(1:2) TO #ADDRESS(1:2)
0064*   MOVE COUNTRY           TO #COUNTRY 
0065*   MOVE AREA-CODE         TO #AREA-CODE
0066*   MOVE PHONE             TO #TELEPHONE
0067*
0068  INPUT USING MAP "LSUBMAP"
0069*
0070  IF *PF-KEY = 'PF4'
0071*
0072    MOVE (AD=I) TO   #CV-NAME-DAM
0073    MOVE (AD=I) TO   #CV-RESEVOIR-VOL
0074    MOVE (AD=I) TO   #CV-SURFACE-AREA
0075    MOVE (AD=I) TO   #CV-WALL-HEIGHT
0076    MOVE (AD=I) TO   #CV-YEAR-COMPLETED
0077    MOVE (AD=I) TO   #CV-IMPOUNDS 
0078    MOVE (AD=I) TO   #CV-LOCALE
0079    MOVE (AD=I) TO   #CV-PROVINCE
0080*
0081    INPUT USING MAP "LSUBMAP"
0082*************VALIDATION***************************
0083    IF NAME-DAM = ' '
0084      REINPUT 'COMPULSORY NAME FOR DAM MUST BE ENTERED' MARK *NAME-DAM
0085    END-IF
0086
0087    IF YEAR-COMPLETED = 0
0088      REINPUT 'ENTER A VALID YEAR COMPLETED' MARK *YEAR-COMPLETED
0089    END-IF
0090
0091    IF YEAR-COMPLETED < 1800 OR YEAR-COMPLETED > 2026
0092REINPUT 'YEAR MUST BE BETWEEN 1800 AND CURRENT YEAR' MARK *YEAR-COMPLETED
0093    END-IF
0094
0095    IF RESEVOIR-VOL < 50
0096  REINPUT 'RESERVOIR VOLUME MUST BE GREATER THAN 100' MARK *RESEVOIR-VOL
0097    END-IF
0098
0099    IF SURFACE-AREA <= 0
0100      REINPUT 'SURFACE AREA MUST BE GREATER THAN 0' MARK *SURFACE-AREA
0101    END-IF
0102
0103    IF WALL-HEIGHT <= 0
0104      REINPUT 'WALL HEIGHT MUST BE GREATER THAN 0' MARK *WALL-HEIGHT
0105    END-IF
0106
0107******************* MOVE DATA BACK TO DATABASE****************
0108*     MOVE #PERSONNEL-ID  TO PERSONNEL-ID
0109*     MOVE #SURNAME       TO NAME
0110*     MOVE #CITY          TO CITY
0111*     MOVE #POSTAL-CODE   TO POST-CODE
0112*     MOVE #ADDRESS(1:2)  TO ADDRESS-LINE(1:2)
0113*     MOVE #COUNTRY       TO COUNTRY
0114*     MOVE #AREA-CODE     TO AREA-CODE
0115*     MOVE #TELEPHONE     TO PHONE
0116*
0117    MOVE (AD=P) TO   #CV-NAME-DAM
0118    MOVE (AD=P) TO   #CV-RESEVOIR-VOL
0119    MOVE (AD=P) TO   #CV-SURFACE-AREA
0120    MOVE (AD=P) TO   #CV-WALL-HEIGHT
0121    MOVE (AD=P) TO   #CV-YEAR-COMPLETED
0122    MOVE (AD=P) TO   #CV-IMPOUNDS 
0123    MOVE (AD=P) TO   #CV-LOCALE
0124    MOVE (AD=P) TO   #CV-PROVINCE
0125    UPDATE
0126* 
0127    INPUT WITH TEXT 'RECORD SUCCESSFULLY UPDATED' USING MAP "LSUBMAP"
0128*
0129  END-IF
0130END-FIND
0131*
0132END TRANSACTION
0133END
0134
0135
