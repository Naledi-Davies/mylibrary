0005DEFINE DATA LOCAL
00061 #SELECTED (A1)
00071 #MAP-INDEX (N5)
0008END-DEFINE
0009*
0010SET KEY PF5 NAMED 'OUT'
0011*
0012REPEAT
0013  INPUT USING MAP 'MENUMAP'
0014*
0015  IF *PF-KEY = 'PF5'
0016    ESCAPE BOTTOM
0017  END-IF
0018*
0019  IF #SELECTED = 'L'
0020    FETCH RETURN 'LIST'
0021  ELSE
0022    IF #SELECTED = 'S'
0023      FETCH RETURN 'DAMSTATS'
0024    ELSE
0025      IF #SELECTED = 'A'
0026        FETCH RETURN 'ADD'
0027      ELSE
0028        WRITE 'Invalid selection. Enter L, S, or A.'
0029      END-IF
0030    END-IF
0031  END-IF
0032*
0033END-REPEAT
0034*
0035END
