0010DEFINE DATA LOCAL
00201 #DAM  (A500)
00301 #NAME-DAM (A50)
00401 #LOCALE (A50)
00501 #PROVINCE (A50)
00601 #IMPOUNDS (A50)
00701 #YEAR-COMPLETED (A4)
00801 #RESEVOIR-VOL (A10)
00901 #SURFACE-AREA (A10)
01001 #WALL-HEIGHT  (A8)
01101 #ALT-NAMES (A50)
01201 #COUNTER (N5)
0130*******************************************
01401 DAMSA VIEW OF DAMSA
0150  2 DAM-ID (A5)
0160  2 NAME-DAM (A50)
0170  2 LOCALE (A50)
0180  2 PROVINCE (A50)
0190  2 IMPOUNDS (A50)
0200  2 ALT-NAMES (A50)
0210  2 YEAR-COMPLETED (N4)
0220  2 RESEVOIR-VOL (N10) 
0230  2 SURFACE-AREA (N3.3)
0240  2 WALL-HEIGHT (N4.3)
0250/*) imported data fields from Data Definition Module DAMSA
0260END-DEFINE
0270*
0280FORMAT LS=200 PS=20
0290*
0300* DEFINE WORK FILES
0310*
0320DEFINE WORK FILE 1
0330  'C:\TRAINING\waterinsouthA.TXT'
0340DEFINE WORK FILE 2
0350  'C:\TRAINING\waterinsouthA2.TXT'
0360DEFINE WORK FILE 3
0370  'C:\TRAINING\waterinsouthAddm.TXT'
0380*
0390* READ THE WORK FILE 
0400READ WORK 1 #DAM 
0410  ADD 1 TO #COUNTER
0420  SEPARATE #DAM INTO
0430    #NAME-DAM
0440    #LOCALE
0450    #PROVINCE
0460    #IMPOUNDS
0470    #YEAR-COMPLETED
0480    #RESEVOIR-VOL 
0490    #SURFACE-AREA
0500    #WALL-HEIGHT
0510    #ALT-NAMES 
0520    WITH DELIMITERS '#'
0530*
0540  MOVE RIGHT #RESEVOIR-VOL TO #RESEVOIR-VOL
0550  MOVE RIGHT #SURFACE-AREA TO #SURFACE-AREA
0560  MOVE RIGHT #WALL-HEIGHT  TO #WALL-HEIGHT
0570*
0580* 
0590*  WRITE WORK 2
0600*     #NAME-DAM
0610*     #LOCALE
0620*     #PROVINCE
0630*     #IMPOUNDS
0640*     #YEAR-COMPLETED
0650*     #RESEVOIR-VOL 
0660*     #SURFACE-AREA
0670*     #WALL-HEIGHT
0680*     #ALT-NAMES 
0690*   
0700* ON ERROR 
0710*   WRITE #COUNTER /
0720*     *ERROR-NR
0730* END-ERROR
0740
0750* remove commas from resevoir volume 
0760* 
0770EXAMINE #RESEVOIR-VOL FOR ',' DELETE
0780*
0790* move records to ddm
0800*
0810  NAME-DAM                  := #NAME-DAM
0820  LOCALE                    := #LOCALE
0830  PROVINCE                  := #PROVINCE
0840  IMPOUNDS                  := #IMPOUNDS
0850  IF #YEAR-COMPLETED IS (N4)
0860    YEAR-COMPLETED         := VAL(#YEAR-COMPLETED)
0870  END-IF
0880  IF #RESEVOIR-VOL IS (N10)
0890    RESEVOIR-VOL           := VAL(#RESEVOIR-VOL)
0900  END-IF
0910  IF #WALL-HEIGHT IS (N4.3)
0920    WALL-HEIGHT            := VAL(#WALL-HEIGHT)
0930  END-IF
0940  IF #SURFACE-AREA IS (N3.3)
0950    SURFACE-AREA           := VAL(#SURFACE-AREA)
0960  END-IF
0970  ALT-NAMES                 := #ALT-NAMES
0980***********************DAM ID*******************************
0990  MOVE EDITED #COUNTER (EM=999) TO DAM-ID
1000* *
1010  WRITE WORK 3
1020    DAM-ID
1030    NAME-DAM
1040    LOCALE
1050    PROVINCE
1060    IMPOUNDS
1070    YEAR-COMPLETED
1080    RESEVOIR-VOL 
1090    SURFACE-AREA
1100    WALL-HEIGHT
1110    ALT-NAMES
1120*   DISPLAY
1130*     'ID'       DAM-ID  
1140*     'DAM NAME' NAME-DAM (AL=20) /*ALPHANUMERIC LENGTH   
1150*     'PROVINCE' PROVINCE (AL=12)  
1160*     'RES-VOL'  RESEVOIR-VOL
1170*     'SURF-AREA'SURFACE-AREA 
1180*     'WALL-HEIGHT'WALL-HEIGHT
1190  STORE DAMSA
1200   END TRANSACTION
1210END-WORK
1220END
1230* STORE DATA
