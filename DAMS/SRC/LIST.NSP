0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 DAMSA VIEW OF DAMSA
0007  2 DAM-ID (A5)
0008  2 NAME-DAM (A50)
0009  2 LOCALE (A50)
0010  2 PROVINCE (A50)
0011  2 IMPOUNDS (A50)
0012  2 ALT-NAMES (A50)
0013  2 YEAR-COMPLETED (N4.0)
0014  2 RESEVOIR-VOL (N10.0)
0015  2 SURFACE-AREA (N3.3)
0016  2 WALL-HEIGHT (N4.3)
0017************#FIELDS********************
0018/*( imported data fields from Map LISTPROG
00191 #DAM-ID (A5/1:16)
00201 #NAME-DAM (A50/1:16)
00211 #IMPOUNDS (A50/1:16)
00221 #LOCALE (A50/1:16)
00231 #PROVINCE (A50/1:16)
00241 #SELECT (A1/1:16)
0025*******************************************
00261 START-VALUE (A20)
00271 RESTART-VALUE (A20)
00281 #LASTSEARCH (A20)
00291 #INDEX (N5)
00301 #S-INDEX (N5)
0031/*( imported data fields from Map MENUMAP
00321 #SELECTED (A1)
0033END-DEFINE
0034**********SET KEY************************
0035SET KEY
0036  PF3 NAMED 'EXIT'
0037  ENTR NAMED 'NEXT>>'  
0038*
0039READ DAMSA WITH REPOSITION
0040    BY NAME-DAM STARTING FROM START-VALUE
0041*
0042  ADD 1 TO #INDEX
0043*
0044  MOVE DAM-ID       TO #DAM-ID(#INDEX)
0045  MOVE NAME-DAM     TO #NAME-DAM (#INDEX)
0046  MOVE LOCALE       TO #LOCALE(#INDEX)
0047  MOVE PROVINCE     TO #PROVINCE (#INDEX)
0048  MOVE IMPOUNDS     TO #IMPOUNDS (#INDEX)
0049* 
0050  IF #INDEX=16
0051    INPUT USING MAP "LISTPROG"
0052    IF RESTART-VALUE NE ' '
0053      MOVE RESTART-VALUE TO START-VALUE #LASTSEARCH 
0054      RESET RESTART-VALUE
0055      RESET #INDEX
0056      ESCAPE TOP REPOSITION
0057    END-IF
0058*
0059    IF *PF-KEY = 'PF3'
0060      INPUT USING MAP "MENUMAP"
0061      ESCAPE BOTTOM
0062    END-IF
0063*        
0064    RESET #INDEX
0065    FOR #S-INDEX = 1 TO 16
0066      IF #SELECT (#S-INDEX) EQ 'U'
0067        CALLNAT "LISTSUB" #DAM-ID(#S-INDEX)
0068      END-IF
0069    END-FOR   
0070  END-IF
0071END-READ
0072IF #INDEX < 16
0073  RESET 
0074    #DAM-ID(#INDEX+1:16)
0075    #NAME-DAM(#INDEX+1:16)
0076    #IMPOUNDS(#INDEX+1:16)
0077    #LOCALE(#INDEX+1:16)
0078    #PROVINCE(#INDEX+1:16)
0079  INPUT USING MAP "LISTPROG"
0080END-IF
0081END
