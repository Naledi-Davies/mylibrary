0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 #RECORD (A100)
00071 #NUMBER (A5)
00081 #COUNTRY-NAME (A30)
00091 #POPULATION (A15)
00101 #REGION (A20)
0011END-DEFINE
0012*
0013FORMAT PS=22
0014*
0015DEFINE WORK FILE 1 'C:\TRAINING\AFR-COUNTRIES.TXT'
0016*
0017READ WORK 1 #RECORD
0018  SEPARATE #RECORD INTO
0019    #NUMBER
0020    #COUNTRY-NAME
0021    #POPULATION
0022    #REGION
0023    WITH DELIMITERS '#'
0024*
0025  EXAMINE #POPULATION FOR ',' DELETE
0026  MOVE RIGHT #POPULATION TO #POPULATION
0027  DISPLAY
0028    #NUMBER
0029    #COUNTRY-NAME
0030    #POPULATION
0031    #REGION
0032*
0033  AT END OF DATA
0034    WRITE 'TOTAL NUMBER'
0035      COUNT (#RECORD)
0036  END-ENDDATA
0037END-WORK
0038*
0039END
