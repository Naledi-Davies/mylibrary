0001/** New Program WRK7FIND.
0002/**
0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 EMPLOYEES-DDM VIEW EMPLOYEES
0007  2 PERSONNEL-ID (A8)
0008  2 NAME (A20)
0009  2 GENDER (A1)
0010  2 DEPT (A6)
00111 #SCAN (A2) INIT <'AL'>
0012END-DEFINE
0013*
0014FORMAT LS=247
0015*
0016F1. FIND EMPLOYEES-DDM WITH 
0017    EMPLOYEES-DDM.DEPT EQ 'SALE20'
0018    AND EMPLOYEES-DDM.DEPARTMENT EQ 'SALE' 
0019    WHERE EMPLOYEES-DDM.GENDER EQ 'F'  
0020*
0021  IF NO RECORD FOUND
0022    WRITE 'NO RECORDS FOUND'
0023    ESCAPE BOTTOM (F1.) 
0024  END-NOREC
0025*
0026  IF  EMPLOYEES-DDM.DEPT = SCAN #SCAN
0027    WRITE EMPLOYEES-DDM.PERSONNEL-ID 
0028      EMPLOYEES-DDM.NAME (AL=10)
0029      EMPLOYEES-DDM.GENDER (AL=1)
0030*       'COUNT' *COUNTER
0031*       'NUMER OF EMPLOYEES' *NUMBER
0032      EMPLOYEES-DDM.DEPT 'CONTAINS AL'
0033  END-IF
0034*   DISPLAY
0035* *    *ISN
0036*     EMPLOYEES-DDM.PERSONNEL-ID
0037*
0038  AT END OF DATA
0039    WRITE 'TOTAL NUMBER'
0040      COUNT(F1.)(EMPLOYEES-DDM.PERSONNEL-ID)
0041  END-ENDDATA
0042*
0043END-FIND
0044*
0045* READ EMPLOYEES-DDM BY DEPT
0046*     WHERE EMPLOYEES-DDM.GENGER EQ SCAN 'F'
0047*   WRITE NOTITLE NOHDR
0048*     EMPLOYEES-DDM.PERSONNEL-ID
0049*     EMPLOYEES-DDM.NAME (AL=10)
0050*     EMPLOYEES-DDM.GENGER
0051*     EMPLOYEES-DDM.DEPT
0052END
