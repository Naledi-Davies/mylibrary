0005DEFINE DATA LOCAL
00061 NUMVALUE (N2) INIT <2>
00071 MESSAGE  (A50) INIT <'VALID'>
0008END-DEFINE
0009*
0010REPEAT 
0011    UNTIL NUMVALUE = 20
0012    ADD 1 TO NUMVALUE
0013*
0014DECIDE FOR EVERY CONDITION
0015  WHEN NUMVALUE = 1 OR NUMVALUE = 2 OR NUMVALUE = 3
0016    MESSAGE := 'VALUE IS 1,2 OR 3' /* FOR RANGE LIKE 1 TO 3 JUST USE A COLON (:)
0017  WHEN NUMVALUE = 5
0018    MESSAGE:= 'VALUE IS 5'
0019  WHEN NUMVALUE = 7 OR NUMVALUE = 8 OR NUMVALUE =10
0020    MESSAGE:= 'THE VALUE IS 7,8 OR 10'
0021WHEN NUMVALUE = 13 OR NUMVALUE = 15 OR NUMVALUE = 16 OR NUMVALUE = 17 OR NUMVALUE = 18
0022    MESSAGE:= 'VALUE IS 13 OR IS IN THE RANGE OF 15 TO 18'
0023  WHEN NONE
0024    MESSAGE:= 'INVALID VALUE'
0025END-DECIDE
0026WRITE MESSAGE
0027END-REPEAT
0028END
