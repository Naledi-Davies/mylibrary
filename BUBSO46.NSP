0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 EMPLOYEES VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8) 
0008  2 FIRST-NAME (A20)
0009  2 NAME (A20)
0010  2 ADDRESS-LINE (A20/1:1)
0011  2 CITY (A20)
0012  2 POST-CODE (A10)
0013  2 COUNTRY (A3)
0014  2 DEPT (A6) 
00151 #EMP-ARRAY (1:*)
0016  2 PERSONNEL-ID (A8)
0017  2 FIRST-NAME   (A20)
0018  2 NAME         (A20)
0019  2 ADDRESS-LINE (A20/1:1)
0020  2 CITY         (A20)
0021  2 POST-CODE    (A10)
0022  2 COUNTRY      (A3)
00231 #TEMP-RECORD
0024  2 PERSONNEL-ID (A8)
0025  2 FIRST-NAME   (A20)
0026  2 NAME         (A20)
0027  2 ADDRESS-LINE (A20/1:1)
0028  2 CITY         (A20)
0029  2 POST-CODE    (A10)
0030  2 COUNTRY      (A3)
00311 #INDEX (N5)
00321 #INNER (N5)
00331 #OUTER (N5)
00341 #COUNT (N5)
0035END-DEFINE
0036* 
0037FORMAT LS = 250
0038* FIND NUMBER EMPLOYEES WITH DEPT = 'MGMT30'
0039* #INDEX := *NUMBER
0040* EXPAND ARRAY #REC TO (1:#INDEX)
0041* RESET #INDEX
0042READ EMPLOYEES BY DEPT EQ 'MGMT30'
0043*
0044  IF EMPLOYEES.DEPT NE 'MGMT30'
0045    ESCAPE BOTTOM
0046  END-IF
0047*
0048  ADD 1 TO #INDEX
0049*
0050RESIZE ARRAY #EMP-ARRAY TO (1:#INDEX)
0051
0052MOVE BY NAME EMPLOYEES TO #EMP-ARRAY(#INDEX) /*THE INDEX INDICATES THE NUMBER OF OCCURANCES ON THE UPPERBOUND
0053END-READ
0054*
0055FOR #OUTER = #INDEX TO 1 STEP -1
0056  FOR #INNER = 1 TO (#INDEX - 1)
0057 IF #EMP-ARRAY.FIRST-NAME (#INNER) GT #EMP-ARRAY.FIRST-NAME (#INNER + 1)
0058      MOVE BY NAME #EMP-ARRAY(#INNER) TO #TEMP-RECORD
0059      MOVE BY NAME #EMP-ARRAY (#INNER + 1) TO #EMP-ARRAY (#INNER)
0060      MOVE BY NAME #TEMP-RECORD TO #EMP-ARRAY (#INNER + 1)
0061    END-IF
0062  END-FOR
0063END-FOR
0064*
0065FOR #INNER = 1 TO #INDEX
0066  WRITE
0067    EMPLOYEES.DEPT
0068    #EMP-ARRAY.PERSONNEL-ID (#INNER)
0069    #EMP-ARRAY.FIRST-NAME (#INNER)
0070    #EMP-ARRAY.NAME (#INNER)
0071    #EMP-ARRAY.ADDRESS-LINE(#INNER,1:1)
0072    #EMP-ARRAY.CITY (#INNER)
0073    #EMP-ARRAY.POST-CODE (#INNER)
0074    #EMP-ARRAY.COUNTRY (#INNER)
0075END-FOR
0076*
0077END
