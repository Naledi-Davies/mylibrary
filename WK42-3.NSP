0005DEFINE DATA LOCAL
00061 EMPLOYEE VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8)
0008  2 COUNTRY (A3)
00091 #COUNT (N5)
00101 #TOTAL (N5)
00111 #ET-COUNT (N5)
0012END-DEFINE
0013*
0014DEFINE WORK FILE 1
0015  'C:\TRAINING\COUNTRYCODESUPDATED.TXT'
0016*
0017FORMAT LS= 250
0018FORMAT PS= 100
0019*
0020READ1. READ EMPLOYEE WITH PERSONNEL-ID
0021*
0022  ADD 1 TO #TOTAL
0023  DECIDE ON FIRST VALUE OF COUNTRY
0024    VALUE 'D'
0025MOVE 'GER' TO COUNTRY /* THE MOVE STATEMENT IS MOST EFFECTIVE TO TRANSFER DATA FROM ONE FIELD TO ANOTHER
0026    VALUE 'DK'
0027      MOVE 'DNK' TO COUNTRY
0028    VALUE 'F'
0029      MOVE 'FRA' TO COUNTRY
0030    VALUE 'E'
0031      MOVE 'ESP' TO COUNTRY
0032    ANY
0033      ADD 1 TO #COUNT
0034      UPDATE
0035      ADD 1 TO #ET-COUNT
0036      IF #ET-COUNT > 50 
0037        END TRANSACTION
0038        RESET #ET-COUNT /* WE RESET SO THE COUNT CAN START FROM 1 AGAIN
0039      END-IF
0040    NONE
0041      IGNORE
0042  END-DECIDE
0043*
0044END-READ
0045*
0046END TRANSACTION
0047*
0048WRITE 'COUNTRIES:' #COUNT 
0049WRITE 'TOTAL    :' #TOTAL
0050* WRITE  'CODE 1:      '  #COUNTRY-ARRAY(1)
0051* WRITE  'CODE 2:      '  #COUNTRY-ARRAY(2)
0052* WRITE  'CODE 3:      '  #COUNTRY-ARRAY(3)
0053* WRITE  'CODE 4:      '  #COUNTRY-ARRAY(4)
0054* WRITE  'CODE 5:      '  #COUNTRY-ARRAY(5)    
0055* WRITE  'CODE 6:      '  #COUNTRY-ARRAY(6)
0056END
