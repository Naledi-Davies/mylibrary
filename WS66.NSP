0001/** New Program WS66.
0002/**
0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL 
00061 EMPLOYEES-DDM VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8)
0008  2 NAME (A20)
0009  2 CITY (A20)
0010  2 COUNTRY (A3)
00111 RESTART-VALUE (A20)
00121 SELECTION (A1)
0013*****************************************
00141 #CITY (A20/1:16)
00151 #NAME (A20/1:16)
00161 #PERSONNEL-ID (A8/1:16)
00171 #SELECTION (A1/1:16)
00181 #INDEX (N3)
00191 EXIT (A9)
00201 #SELECT-INDEX (N3)
00211 START-VALUE (A20)
0022****************************
00231 #LASTSEARCH (A20)
00241 #ISN (N8/1:16)
0025END-DEFINE
0026* 
0027SET KEY
0028  PF3 NAMED 'EXIT'
0029  ENTR NAMED 'NEXT>>' 
0030*
0031READ EMPLOYEES-DDM WITH REPOSITION
0032    BY NAME STARTING FROM START-VALUE
0033  /**     STARTING FROM RESTART-VALUE
0034*
0035  ADD 1 TO #INDEX
0036*
0037  MOVE PERSONNEL-ID TO #PERSONNEL-ID(#INDEX)
0038  MOVE NAME         TO #NAME (#INDEX)
0039  MOVE CITY         TO #CITY(#INDEX)
0040  MOVE SELECTION    TO #SELECTION(#INDEX)
0041  MOVE *ISN         TO #ISN(#INDEX)
0042* 
0043  IF #INDEX=16
0044    INPUT USING MAP "WRK41MAP"
0045    IF RESTART-VALUE NE ' '
0046      MOVE RESTART-VALUE TO START-VALUE #LASTSEARCH 
0047      RESET RESTART-VALUE
0048      RESET #INDEX
0049      ESCAPE TOP REPOSITION
0050    END-IF
0051*
0052    IF *PF-KEY = 'PF3'
0053      ESCAPE BOTTOM
0054    END-IF
0055*
0056    RESET #INDEX
0057    FOR #SELECT-INDEX = 1 TO 16
0058      IF #SELECTION (#SELECT-INDEX) NE ' '
0059      CALLNAT "WS66SUB" #PERSONNEL-ID(#SELECT-INDEX) #ISN(#SELECT-INDEX)
0060      END-IF
0061    END-FOR   
0062  END-IF
0063END-READ
0064IF #INDEX < 16
0065  RESET #PERSONNEL-ID(#INDEX+1:16)
0066    #NAME(#INDEX+1:16)
0067    #CITY(#INDEX+1:16)
0068  INPUT USING MAP "WRK41MAP"
0069END-IF
0070END
