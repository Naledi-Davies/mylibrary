0008DEFINE DATA LOCAL
00091 EMPLOYEES VIEW OF EMPLOYEES
0010  2 PERSONNEL-ID (A8)
0011  2 FULL-NAME
0012    3 NAME (A20)
0013  2 FULL-ADDRESS
0014    3 ADDRESS-LINE (A20/1:2)
0015    3 CITY (A20)
0016    3 COUNTRY (A3)
0017*
00181 #ADDRESS-LINE (A20/1:2)
00191 #CITY (A20)
00201 #COUNTRY (A3)
00211 #NAME (A20)
00221 #PERSONNEL-ID (A8)
00231 #DIRECTION (A1) INIT <'A'>
0024END-DEFINE
0025*
0026SET KEY
0027  PF3 NAMED 'EXIT'
0028  PF4 NAMED 'ASC'
0029  PF5 NAMED 'DESC'
0030*
0031READ EMPLOYEES IN DYNAMIC #DIRECTION BY PERSONNEL-ID
0032*
0033  MOVE PERSONNEL-ID    TO #PERSONNEL-ID
0034  MOVE NAME            TO #NAME
0035  MOVE CITY            TO #CITY
0036  MOVE COUNTRY         TO #COUNTRY
0037  MOVE ADDRESS-LINE(*) TO #ADDRESS-LINE(*)
0038*
0039  INPUT USING MAP "PRCMAP2"
0040*
0041  IF *PF-KEY = 'PF3'
0042    ESCAPE MODULE
0043  END-IF
0044*
0045  IF *PF-KEY = 'PF4'
0046    #DIRECTION := 'A'
0047  END-IF
0048*
0049  IF *PF-KEY = 'PF5'
0050    #DIRECTION := 'D'
0051  END-IF
0052*
0053END-READ
0054*
0055END
