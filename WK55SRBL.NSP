0005DEFINE DATA LOCAL
00061 #ALPHA (A1/1:26) INIT (1)<'A'> (2)<'B'> (3)<'C'> (4)<'D'> (5)<'E'>
0007(6)<'F'> (7)<'G'> (8)<'H'> (9)<'I'> (10)<'J'> (11)<'K'> (12)<'L'> (13)<'M'> 
0008(14)<'N'>(15)<'O'> (16)<'P'> (17)<'Q'> (18)<'R'> (19)<'S'>(20)<'T'> (21)<'U'> 
0009  (22)<'V'> (23)<'W'> (24)<'X'>(25)<'Y'> (26)<'Z'>
00101 #POINTS (N2/1:26) INIT (1)<1> (2)<3> (3)<3> (4)<2> (5)<1>
0011  (6)<4> (7)<2> (8)<4> (9)<1> (10)<8> (11)<5> (12)<1> (13)<3>
0012  (14)<1>(15)<1> (16)<3> (17)<10> (18)<1> (19)<1>(20)<1> (21)<1>
0013  (22)<4> (23)<4> (24)<8>(25)<4>(26)<10>
00141 #TOTAL (N2)
00151 IN-WORD(A25)
00161 REDEFINE IN-WORD
0017  2 #IN-ARRAY (A1/1:25)
00181 #INDEX(N5)
00191 #INDEX1(N5)
00201 #BIGGEST (N5)
00211 #END-TIME (N5)
0022END-DEFINE
0023*
0024ST. SETTIME
0025WRITE 'START TIME:' *TIME 
0026*  
0027DEFINE WORK FILE 1 'C:\TRAINING\6LETTERWORDS.TXT'
0028DEFINE WORK FILE 2 'C:\TRAINING\6LETTERWORDS(2).TXT'
0029*
0030READ WORK FILE 1 IN-WORD
0031  IN-WORD := *TRANSLATE(IN-WORD,UPPER)
0032  FOR #INDEX= 1 TO 25
0033    FOR #INDEX1 = 1 TO 26
0034      IF #IN-ARRAY(#INDEX) = #ALPHA(#INDEX1)
0035        ADD #POINTS(#INDEX1) TO #TOTAL
0036        ESCAPE BOTTOM
0037      END-IF
0038      IF #IN-ARRAY(#INDEX) = ' '
0039        ESCAPE BOTTOM
0040      END-IF
0041    END-FOR 
0042  END-FOR
0043*
0044  WRITE WORK FILE 2 IN-WORD ':' #TOTAL
0045*
0046  IF #BIGGEST LT #TOTAL
0047    MOVE #TOTAL TO #BIGGEST
0048  END-IF
0049*
0050  RESET #TOTAL
0051*
0052END-WORK
0053*
0054WRITE 'END TIME:  ' *TIME
0055WRITE 'BIGGEST:' #BIGGEST
0056*
0057END
