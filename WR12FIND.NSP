0005DEFINE DATA LOCAL
00061 EMPLOYEES-FIND VIEW EMPLOYEES
0007  2 PERSONNEL-ID (A8)
0008    2REDEFINE PERSONNEL-ID
0009    3 COUNTRY-CODE (A1)
0010  2 FIRST-NAME (A20)
0011  2 NAME (A20)
0012  2 ADDRESS-LINE (A20/1:191)
0013  2 CITY (A20)
0014  2 POST-CODE (A10)
0015  2 COUNTRY (A3)
0016
0017END-DEFINE
0018*
0019FORMAT LS= 250
0020FORMAT PS= 18
0021* USE READ STATEMENT AS COUNTRY IS NOT A DESCRIPTOR
0022
0023DEFINE WORK FILE 1
0024  'C:\TRAINING\NAMES1.TXT'
0025*
0026READ1. READ EMPLOYEES-FIND BY PERSONNEL-ID
0027    FROM  '1' TO '19999999'
0028*
0029  IF COUNTRY-CODE NE '1' 
0030    ESCAPE BOTTOM (READ1.)
0031  END-IF
0032*
0033  WRITE WORK 1
0034    PERSONNEL-ID
0035    NAME
0036    FIRST-NAME
0037    ADDRESS-LINE(1)
0038    POST-CODE
0039    CITY
0040    COUNTRY
0041END-READ
0042*
0043WRITE 'RECORDS WRITTEN TO WORK FILE'
0044  *COUNTER (READ1.)
0045END
