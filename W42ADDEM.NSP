0001/** New Program W42ADDEM.
0002/**
0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 EMPLOYEE VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8)
0008  2 FIRST-NAME (A20)
0009  2 NAME (A20)
0010  2 MAR-STAT (A1)
0011  2 GENDER (A1)
0012  2 ADDRESS-LINE (A20/1:2)
0013  2 LANG (A3/1:5)
0014  2 CITY (A20)
0015  2 POST-CODE (A10)
0016  2 COUNTRY (A3)
0017  2 DEPT (A6)
0018  2 JOB-TITLE (A25)
0019***************map fields ****************
00201 #ADDRESS (A20/1:2)
00211 #FIRST-NAME (A20)
00221 #GENDER (A1)
00231 #LANGUAGES (A3/1:5)
00241 #MARITAL-STATUS (A1)
00251 #PERSON-ID (A8)
00261 REDEFINE #PERSON-ID
0027  2 #PERSON-ID-N (N8)
00281 #SURNAME (A20)
00291 #CITY (A20)
00301 #COUNTRY (A3)
00311 #DEPARTMENT (A6)
00321 #JOB-TITLE (A25)
00331 #POSTAL-CODE (A10)
0034END-DEFINE
0035*
0036SET KEY
0037  PF3 NAMED  'EXIT'
0038*
0039READ (1) EMPLOYEE DESCENDING BY PERSONNEL-ID
0040*
0041  UPDATE /*UPDATING OUR PERSON ID
0042  MOVE PERSONNEL-ID  TO #PERSON-ID /* MOVING THE VIEW FIELD TO HASH FIELD
0043  ADD 1 TO #PERSON-ID-N /* PERSON ID REDEFINED TO NUMERIC SO THAT WE CAN ADD 1 TO THE LAST PERSON ID TO CREATE A NEW PERSON ID
0044*
0045  INPUT USING MAP "WK42EMP"
0046*
0047IF *PF-KEY = 'PF3'
0048      ESCAPE BOTTOM
0049    END-IF
0050**************VALIDATION**************
0051  IF #SURNAME = ' '
0052    REINPUT 'SURNAME MUST BE ENTERED' MARK *#SURNAME
0053  END-IF
0054  IF #FIRST-NAME = ' '
0055    REINPUT 'NAME MUST BE ENTERED' MARK  *#FIRST-NAME
0056  END-IF 
0057  IF NOT (#MARITAL-STATUS = 'W' OR
0058      #MARITAL-STATUS = 'M' OR
0059      #MARITAL-STATUS = 'S' OR
0060      #MARITAL-STATUS = 'D')
0061    REINPUT 'INVALID MARITAL STATUS' MARK *#MARITAL-STATUS
0062  END-IF
0063  IF NOT  (#GENDER = 'F' OR
0064      #GENDER = 'M' )
0065    REINPUT 'INVALID GENDER' MARK *#GENDER
0066  END-IF
0067  IF #ADDRESS(1) = ' '
0068 REINPUT 'AT LEAST ONE ADDRESS LINE MUST BE ENTERED' MARK *#ADDRESS(1:2)
0069  END-IF
0070  IF #CITY = ' '
0071    REINPUT 'CITY MUST BE ENTERED' MARK *#CITY
0072  END-IF
0073  IF #POSTAL-CODE = ' '
0074    REINPUT 'POSTAL CODE MUST BE ENTERED' MARK *#POSTAL-CODE
0075  END-IF
0076  IF #COUNTRY = ' '
0077    REINPUT 'COUNTRY MUST BE ENTERED' MARK *#COUNTRY
0078  END-IF
0079  IF #JOB-TITLE  = ' '
0080    REINPUT 'JOB TITLE CODE MUST BE ENTERED' MARK *#JOB-TITLE
0081  END-IF
0082  IF #DEPARTMENT = ' '
0083    REINPUT 'DEPARTMENT MUST BE ENTERED' MARK *#DEPARTMENT
0084  END-IF
0085*
0086************* MOVE #FIELDS TO VIEW FIELDS*************
0087/*  ONCE EVERYTHING HAS BEEN CHECKED AND FINALISED THAT IS WHEN WE MOVE #FIELDS TO VIEW FIELDS
0088  PERSONNEL-ID      := #PERSON-ID
0089  FIRST-NAME        := #FIRST-NAME
0090  NAME              := #SURNAME
0091  MAR-STAT          := #MARITAL-STATUS
0092  GENDER            := #GENDER
0093  ADDRESS-LINE(1:2) := #ADDRESS(1:2)
0094  CITY              := #CITY
0095  COUNTRY           := #COUNTRY
0096  DEPT              := #DEPARTMENT
0097  JOB-TITLE         := #JOB-TITLE 
0098  POST-CODE         := #POSTAL-CODE
0099  LANG (1:5)        := #LANGUAGES (1:5)
0100************ STORE ************
0101STORE EMPLOYEE
0102* END TRANSACTION
0103END-READ
0104*
0105INPUT USING MAP "W42NEWID"
0106*
0107END
