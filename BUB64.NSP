0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 EMPLOYEES VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID   (A8)
0008  2 NAME           (A20)
0009  2 FIRST-NAME     (A20)
0010  2 DEPT           (A6)
0011  2 JOB-TITLE      (A25)
00121 #FLAG            (A1)
0013END-DEFINE
0014*
0015FORMAT LS = 250
0016DEFINE WORK FILE 1 'C:\TRAINING\BUBBLE64.TXT'
0017DEFINE WORK FILE 2 'C:\TRAINING\BUBBLES64-2.TXT'
0018DEFINE WORK FILE 3 'C:\TRAINING\BUBBLES64ALL.TXT'
0019*
0020READ EMPLOYEES BY NAME
0021*
0022  DECIDE ON FIRST VALUE OF #FLAG
0023    VALUE ' '
0024      WRITE WORK 1 EMPLOYEES
0025      WRITE WORK 3 EMPLOYEES
0026      MOVE '1' TO #FLAG
0027    VALUE '1'
0028      WRITE WORK 2 EMPLOYEES
0029      WRITE WORK 3 EMPLOYEES
0030      RESET #FLAG
0031    NONE
0032      IGNORE
0033  END-DECIDE
0034*
0035END-READ
0036* WRITE
0037*   'TOTAL RECORDS READ : ' #COUNT
0038END
