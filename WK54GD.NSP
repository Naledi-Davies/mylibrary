0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 EMP VIEW OF EMPLOYEES
00072 DEPT (A6) /*ACTUAL DEPARTMENTS (YOU CAN JUST REDEFINE, NO NEED TO IMPORT DEPARTMENT)
0008  2 DEPARTMENT (A4) /*GROUPS
0009  2 PERSONNEL-ID (A8)
0010*******************************************************************
00111 INDEX1 (N4)
00121 INDEX2 (N4)
0013*******************************************************************
00141 #DEPT (A6/1:170)
00151 #DEPARTMENT (A4/1:15)
00161 #PERSONNEL-ID (A8)
0017*******************************************************************
00181 #COUNT1 (N3/1:15)
00191 #COUNT2 (N3/1:170)
0020END-DEFINE
0021*
0022DEFINE WORK FILE 1 'C:\TRAINING\DEPARTMENTS-1.TXT'
0023DEFINE WORK FILE 2 'C:\TRAINING\GROUPS-1.TXT'
0024*
0025READ EMP
0026*
0027***********COUNTING GROUPS*****************
0028  FOR INDEX1 = 1 TO 15
0029    IF  #DEPARTMENT(INDEX1) = ' '
0030      MOVE DEPARTMENT TO #DEPARTMENT(INDEX1)
0031      ADD 1 TO #COUNT1(INDEX1)
0032      ESCAPE BOTTOM
0033    ELSE
0034      IF DEPARTMENT = #DEPARTMENT(INDEX1)
0035        ADD 1 TO #COUNT1(INDEX1)
0036        ESCAPE BOTTOM
0037      END-IF
0038    END-IF
0039  END-FOR
0040***********COUNTING DEPARTMENTS***********
0041  FOR INDEX2 = 1 TO 170
0042    IF #DEPT(INDEX2) = ' '
0043      MOVE DEPT TO #DEPT(INDEX2)
0044      ADD 1 TO #COUNT2(INDEX2)
0045      ESCAPE BOTTOM
0046    ELSE
0047      IF DEPT = #DEPT(INDEX2)
0048        ADD 1 TO #COUNT2(INDEX2)
0049        ESCAPE BOTTOM
0050      END-IF
0051    END-IF
0052  END-FOR
0053END-READ
0054FOR INDEX2 = 1 TO 170
0055  IF #DEPT(INDEX2) = ' '
0056    ESCAPE BOTTOM
0057  END-IF
0058  WRITE WORK FILE 1 '#' #DEPT(INDEX2) ':' #COUNT2(INDEX2)
0059END-FOR
0060FOR INDEX1 = 1 TO 15
0061  IF #DEPARTMENT(INDEX1) = ' '
0062    ESCAPE BOTTOM
0063  END-IF
0064  WRITE WORK FILE 2  '#' #DEPARTMENT(INDEX1) ':' #COUNT1(INDEX1)
0065END-FOR
0066END
