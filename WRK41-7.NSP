0001/** New Program WRK41.
0002/**
0003/** :author tda
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL 
00061 EMPLOYEES-DDM VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8)
0008  2 NAME (A20)
0009  2 CITY (A20)
00101 RESTART-VALUE (A20)
00111 SELECTION (A1)
00121 CHASSIS-NUM (B4)
0013*******************************************
00141 #CITY (A20/1:16)
00151 #NAME (A20/1:16)
00161 #PERSONNEL-ID (A8/1:16)
00171 #SELECTION (A1/1:16)
00181 #INDEX (N3)
00191 EXIT (A9)
00201 #SELECT-INDEX (N3)
00211 START-VALUE (A20)
00221 BACK (A9)
00231 #FIRST-NAME (A20)
00241 #GENDER (A1)
00251 #LANGUAGE (A3/1:5)
00261 #MARITAL-STATUS (A1)
00271 #MIDDLE-NAME (A20)
00281 #PERSON-ID (A8)
00291 #SURNAME (A20)
0030*******************************************
00311 #COUNT (N3)
0032*******************************************
00331 #GENDER-DESCRIPTION (A10)
00341 #MARITAL-STATUS-DESCRIPTION (A20)
0035*****************#CV FIELDS****************
00361 #CV-DESCRIPTION (C)
00371 #CV-FIRST-NAME (C)
00381 #CV-LANGUAGE (C/1:5)
00391 #CV-MIDDLE-NAME (C)
00401 #CV-PERSON-ID (C)
00411 #CV-SURNAME (C)
00421 #CV-GENDER (C)
00431 #CV-MARITAL-STATUS (C)
0044********************************************
00451 #SELECT (A1/1:4)
00461 #CHOOSE (A1/1:2)
0047*******************************************
00481 #LASTSEARCH (A20)
0049END-DEFINE
0050*
0051
0052SET KEY
0053  PF3 NAMED  'EXIT'
0054  ENTR NAMED 'NEXT>>'
0055  PF1 = HELP
0056*
0057READ EMPLOYEES-DDM WITH REPOSITION
0058    BY NAME STARTING FROM START-VALUE
0059 /**     STARTING FROM RESTART-VALUE
0060*
0061  ADD 1 TO #INDEX
0062*
0063  MOVE PERSONNEL-ID TO #PERSONNEL-ID(#INDEX)
0064  MOVE NAME         TO #NAME (#INDEX)
0065  MOVE CITY         TO #CITY(#INDEX)
0066  MOVE SELECTION    TO #SELECTION(#INDEX)
0067* 
0068  IF #INDEX=16
0069    INPUT USING MAP "WRK41MAP"
0070    IF RESTART-VALUE NE ' '
0071      MOVE RESTART-VALUE TO START-VALUE #LASTSEARCH
0072      RESET RESTART-VALUE
0073      RESET #INDEX
0074      ESCAPE TOP REPOSITION
0075    END-IF
0076*
0077    IF *PF-KEY = 'PF3'
0078      ESCAPE BOTTOM
0079    END-IF
0080*
0081    RESET #INDEX
0082    FOR #SELECT-INDEX = 1 TO 16
0083      IF #SELECTION (#SELECT-INDEX) EQ 'A'
0084        CALLNAT "WRK41-2B" #PERSONNEL-ID(#SELECT-INDEX)
0085*         RESET #SELECTION(#SELECT-INDEX)
0086      END-IF
0087      IF #SELECTION (#SELECT-INDEX) EQ 'V'
0088    CALLNAT "WRK41SUB" #PERSONNEL-ID(#SELECT-INDEX) #NAME(#SELECT-INDEX)
0089      END-IF
0090      IF #SELECTION (#SELECT-INDEX) EQ 'C'
0091     CALLNAT "WK41COM" #PERSONNEL-ID(#SELECT-INDEX) #NAME(#SELECT-INDEX)
0092      END-IF 
0093      IF #SELECTION (#SELECT-INDEX) EQ 'P'
0094     CALLNAT "WK41PERS" #PERSONNEL-ID(#SELECT-INDEX) #NAME(#SELECT-INDEX)
0095      END-IF
0096    END-FOR
0097  END-IF
0098*
0099END-READ
0100*
0101IF #INDEX < 16
0102  RESET #PERSONNEL-ID(#INDEX+1:16)
0103    #NAME(#INDEX+1:16)
0104    #CITY(#INDEX+1:16)
0105  INPUT USING MAP "WRK41MAP"
0106END-IF
0107*
0108END
