0017/** New Subprogram WRK41SUB.
0018/**
0019/** :author tda
0020/* TODO Enter your code here
0021DEFINE DATA PARAMETER
00221 #PERSONNEL-ID (A8)
00231 #NAME (A20)
0024LOCAL
00251 EMPLOYEE VIEW OF EMPLOYEES 
0026  2 PERSONNEL-ID (A8)
0027  2 FIRST-NAME (A20)
0028  2 MIDDLE-I (A20)
0029  2 NAME (A20)
0030  2 MAR-STAT (A1)
0031  2 GENDER (A1)
0032  2 LANG (A3/1:5)
0033******************************************
00341 #FIRST-NAME (A20)
00351 #GENDER (A1)
00361 #LANGUAGE (A3/1:5)
00371 #MARITAL-STATUS (A1)
00381 #MIDDLE-NAME (A20)
00391 #PERSON-ID (A8)
00401 #SURNAME (A20)
0041*******************************************
00421 #COUNT (N3)
0043*******************************************
00441 #GENDER-DESCRIPTION (A10)
00451 #MARITAL-STATUS-DESCRIPTION (A20)
0046*****************#CV FIELDS****************
00471 #CV-DESCRIPTION (C)
00481 #CV-FIRST-NAME (C)
00491 #CV-LANGUAGE (C/1:5)
00501 #CV-MIDDLE-NAME (C)
00511 #CV-SURNAME (C)
00521 #CV-GENDER (C)
00531 #CV-MARITAL-STATUS (C)
0054*********************************************
00551 #SELECT (A1/1:4)
00561 #CHOOSE (A1/1:2)
0057END-DEFINE
0058*
0059SET KEY
0060  PF4 NAMED 'UPDATE'
0061
0062MOVE (AD=P) TO 
0063  #CV-DESCRIPTION
0064  #CV-FIRST-NAME
0065  #CV-LANGUAGE (1:5)
0066  #CV-MIDDLE-NAME
0067  #CV-SURNAME
0068  #CV-GENDER
0069  #CV-MARITAL-STATUS
0070*
0071FIND EMPLOYEE WITH PERSONNEL-ID = #PERSONNEL-ID
0072*
0073  ADD 1 TO #COUNT
0074*
0075  MOVE #PERSONNEL-ID TO #PERSON-ID
0076  MOVE #NAME         TO #SURNAME
0077  MOVE FIRST-NAME    TO #FIRST-NAME
0078  MOVE MIDDLE-I      TO #MIDDLE-NAME
0079  MOVE MAR-STAT      TO #MARITAL-STATUS
0080  MOVE GENDER        TO #GENDER
0081  MOVE LANG (1:5)    TO #LANGUAGE(1:5)
0082*
0083  DECIDE ON FIRST VALUE OF #GENDER
0084    VALUE 'M'
0085MOVE 'MALE' TO #GENDER-DESCRIPTION /* THE MOVE STATEMENT IS MOST EFFECTIVE TO TRANSFER DATA FROM ONE FIELD TO ANOTHER
0086    VALUE 'F'
0087      MOVE 'FEMALE' TO #GENDER-DESCRIPTION
0088    NONE VALUE
0089      MOVE 'UNKNOWN' TO #GENDER-DESCRIPTION
0090  END-DECIDE
0091*
0092  DECIDE ON FIRST VALUE OF #MARITAL-STATUS
0093    VALUE 'S'
0094MOVE 'SINGLE' TO #MARITAL-STATUS-DESCRIPTION  /* THE MOVE STATEMENT IS MOST EFFECTIVE TO TRANSFER DATA FROM ONE FIELD TO ANOTHER
0095    VALUE 'M'
0096      MOVE 'MARRIED' TO #MARITAL-STATUS-DESCRIPTION
0097    VALUE 'D'
0098      MOVE 'DIVORCED' TO #MARITAL-STATUS-DESCRIPTION
0099    VALUE 'W'
0100      MOVE 'WIDOWED' TO #MARITAL-STATUS-DESCRIPTION
0101    NONE VALUE
0102      MOVE 'UNKNOWN' TO #MARITAL-STATUS-DESCRIPTION
0103  END-DECIDE
0104*
0105  INPUT USING MAP "W41PI"
0106*
0107  IF *PF-KEY = 'PF4'
0108*
0109    MOVE (AD=I) TO
0110      #CV-DESCRIPTION
0111      #CV-FIRST-NAME
0112      #CV-LANGUAGE (1:5)
0113      #CV-MIDDLE-NAME
0114      #CV-SURNAME
0115      #CV-GENDER
0116      #CV-MARITAL-STATUS
0117*
0118    INPUT USING MAP "W41PI"
0119* END-IF
0120*
0121
0122*************VALIDATION***************************
0123    IF #SURNAME = ' '
0124      REINPUT 'SURNAME MUST BE ENTERED' MARK *#SURNAME
0125    END-IF
0126    IF #FIRST-NAME = ' '
0127      REINPUT 'NAME MUST BE ENTERED' MARK  *#FIRST-NAME
0128    END-IF
0129    IF NOT (#MARITAL-STATUS = 'W' OR
0130        #MARITAL-STATUS = 'M' OR
0131        #MARITAL-STATUS = 'S' OR
0132        #MARITAL-STATUS = 'D')
0133      REINPUT 'INVALID MARITAL STATUS' MARK *#MARITAL-STATUS
0134    END-IF
0135    IF NOT  (#GENDER = 'F' OR
0136        #GENDER = 'M' )
0137      REINPUT 'INVALID GENDER' MARK *#GENDER
0138    END-IF
0139    IF #LANGUAGE(1) = ' '
0140      REINPUT 'ADD AT LEAST ADD ONE LANGUAGE SPOKEN' MARK *#LANGUAGE(1)
0141    END-IF
0142******************* MOVE DATA BACK TO DATABASE****************
0143    MOVE #FIRST-NAME      TO FIRST-NAME
0144    MOVE #MIDDLE-NAME     TO MIDDLE-I
0145    MOVE #SURNAME         TO NAME
0146    MOVE #MARITAL-STATUS  TO MAR-STAT
0147    MOVE #GENDER          TO GENDER
0148    MOVE #LANGUAGE (1:5)  TO LANG (1:5)
0149*
0150    MOVE (AD=P) TO
0151      #CV-DESCRIPTION
0152      #CV-FIRST-NAME
0153      #CV-LANGUAGE (1:5)
0154      #CV-MIDDLE-NAME
0155      #CV-SURNAME
0156      #CV-GENDER
0157      #CV-MARITAL-STATUS
0158    UPDATE
0159*     END TRANSACTION
0160    INPUT WITH TEXT 'RECORD SUCCESSFULLY UPDATED' USING MAP 'W41PI'
0161*
0162  END-IF
0163END-FIND     
0164* 
0165END
0166
