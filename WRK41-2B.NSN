0005/** New Subprogram WRK41SUB.
0006/**
0007/** :author tda
0008/* TODO Enter your code here
0009DEFINE DATA PARAMETER
00101 #PERSONNEL-ID (A8)
0011LOCAL 
00121 EMPLOYEE VIEW OF EMPLOYEES
0013  2 PERSONNEL-ID (A8)
0014  2 ADDRESS-LINE (A20/1:2)
0015  2 NAME (A20)
0016  2 CITY (A20)
0017  2 POST-CODE (A10)
0018  2 COUNTRY (A3)
0019  2 AREA-CODE (A6)
0020  2 PHONE (A15)
0021******************************************
00221 #PERSON-ID (A20)
00231 #SURNAME (A20)
00241 #POSTAL-CODE (A10)
00251 #ADDRESS (A20/1:2)
00261 #CITY (A20)
00271 #COUNTRY (A3)
00281 #AREA-CODE (A6)
00291 #TELEPHONE (A15)
0030*************cv-fields*******************  
00311 #CV-ADDRESS (C/1:2)
00321 #CV-AREA-CODE (C)
00331 #CV-CITY (C)
00341 #CV-POSTAL-CODE (C)
00351 #CV-SURNAME (C)
00361 #CV-TELEPHONE (C)
0037
0038END-DEFINE
0039*
0040SET KEY
0041  PF4 NAMED 'UPDATE'
0042*
0043MOVE (AD=P) TO   #CV-ADDRESS(1:2)
0044MOVE (AD=P) TO   #CV-AREA-CODE
0045MOVE (AD=P) TO   #CV-CITY
0046MOVE (AD=P) TO   #CV-POSTAL-CODE
0047MOVE (AD=P) TO   #CV-SURNAME
0048MOVE (AD=P) TO   #CV-TELEPHONE
0049*
0050FIND EMPLOYEE WITH PERSONNEL-ID = #PERSONNEL-ID
0051*
0052  MOVE PERSONNEL-ID      TO #PERSON-ID
0053  MOVE NAME              TO #SURNAME
0054  MOVE CITY              TO #CITY
0055  MOVE POST-CODE         TO #POSTAL-CODE
0056  MOVE ADDRESS-LINE(1:2) TO #ADDRESS(1:2)
0057  MOVE COUNTRY           TO #COUNTRY 
0058  MOVE AREA-CODE         TO #AREA-CODE
0059  MOVE PHONE             TO #TELEPHONE
0060*
0061  INPUT USING MAP "WK41-2"
0062*
0063  IF *PF-KEY = 'PF4'
0064*
0065    MOVE (AD=I) TO      #CV-ADDRESS(1:2)
0066    MOVE (AD=I) TO      #CV-AREA-CODE
0067    MOVE (AD=I) TO     #CV-CITY
0068    MOVE (AD=I) TO      #CV-POSTAL-CODE
0069    MOVE (AD=I) TO      #CV-SURNAME
0070    MOVE (AD=I) TO     #CV-TELEPHONE
0071*
0072    INPUT USING MAP "WK41-2"
0073*************VALIDATION***************************
0074    IF #SURNAME = ' '
0075      REINPUT 'SURNAME MUST BE ENTERED' MARK *#SURNAME
0076    END-IF
0077    IF #ADDRESS(1) = ' '
0078      REINPUT 'PLEASE ENTER VALID ADDRESS' MARK  *#ADDRESS(1)
0079    END-IF
0080    IF #AREA-CODE = ' '
0081      REINPUT 'PLEASE ENTER VALID AREA COE' MARK *#AREA-CODE
0082    END-IF
0083    IF #CITY =  ' '
0084      REINPUT 'PLEASE ENTER A CITY' MARK *#CITY
0085    END-IF
0086    IF #POSTAL-CODE = ' '
0087      REINPUT 'PLEASE ENTER VALID POSTAL CODE' MARK *#POSTAL-CODE
0088    END-IF
0089    IF #TELEPHONE = ' '
0090      REINPUT 'INSERT TELEPHONE NUMBER' MARK *#TELEPHONE
0091    END-IF
0092******************* MOVE DATA BACK TO DATABASE****************
0093    MOVE #PERSONNEL-ID  TO PERSONNEL-ID
0094    MOVE #SURNAME       TO NAME
0095    MOVE #CITY          TO CITY
0096    MOVE #POSTAL-CODE   TO POST-CODE
0097    MOVE #ADDRESS(1:2)  TO ADDRESS-LINE(1:2)
0098    MOVE #COUNTRY       TO COUNTRY
0099    MOVE #AREA-CODE     TO AREA-CODE
0100    MOVE #TELEPHONE     TO PHONE
0101*
0102
0103    MOVE (AD=P) TO      #CV-ADDRESS(1:2)
0104    MOVE (AD=P) TO      #CV-AREA-CODE
0105    MOVE (AD=P) TO      #CV-CITY
0106    MOVE (AD=P) TO      #CV-POSTAL-CODE
0107    MOVE (AD=P) TO      #CV-SURNAME
0108    MOVE (AD=P) TO      #CV-TELEPHONE
0109    UPDATE
0110*     END TRANSACTION
0111    INPUT WITH TEXT 'RECORD SUCCESSFULLY UPDATED' USING MAP "WK41-2"
0112*
0113  END-IF
0114END-FIND
0115*
0116END
0117
