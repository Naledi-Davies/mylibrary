0005DEFINE DATA LOCAL
00061 EMPLOYEE-DDM VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8)
0008  2 NAME (A20)
0009  2 GENDER (A1)
0010  2 COUNTRY (A3)
00111 NAMER (A20)
0012END-DEFINE
0013
0014REPEAT 
0015  INPUT 'PLEASE WRITE YOUR NAME BELOW'
0016    'NAME:' NAMER (AD=A)
0017  IF NAMER = '#'
0018    ESCAPE BOTTOM
0019  END-IF
0020  FIND EMPLOYEE-DDM WITH PHONETIC-NAME = NAMER
0021    DISPLAY *ISN
0022      EMPLOYEE-DDM.PERSONNEL-ID
0023      EMPLOYEE-DDM.NAME (AL=10)
0024      EMPLOYEE-DDM.GENDER
0025      EMPLOYEE-DDM.COUNTRY
0026  END-FIND
0027END-REPEAT
0028END
0029
