0004/* TODO Enter your code here
0005DEFINE DATA PARAMETER
00061 #COUNTRY (A20)
0007LOCAL
00081 #INDEX (N5)
00091 #SELECT (A1/1:7) 
0010END-DEFINE
0011*
0012INPUT USING MAP "CNTRYMAP"
0013*
0014FOR #INDEX = 1 TO 7
0015  IF #SELECT(1)= 'S'
0016    MOVE 'SOUTH AFRICA' TO #COUNTRY
0017  END-IF
0018*
0019  IF #SELECT(2)= 'Z'
0020    MOVE 'ZIMBABWE' TO #COUNTRY
0021  END-IF
0022*
0023  IF #SELECT(3)= 'B'
0024    MOVE 'BOTSWANA' TO #COUNTRY
0025  END-IF
0026*
0027  IF #SELECT(4)= 'N'
0028    MOVE 'NAMIBIA' TO #COUNTRY
0029  END-IF
0030*
0031  IF #SELECT(5)= 'E'
0032    MOVE 'ESWATINI' TO #COUNTRY
0033  END-IF
0034*
0035  IF #SELECT(6)= 'L'
0036    MOVE 'LESOTHO' TO #COUNTRY
0037  END-IF
0038*
0039  IF #SELECT(7)= 'M'
0040    MOVE 'MOZAMBIQUE' TO #COUNTRY
0041  END-IF
0042*
0043END-FOR
0044* 
0045END
