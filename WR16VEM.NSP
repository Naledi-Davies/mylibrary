0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 VEHICLES VIEW OF VEHICLES
0007  2 REG-NUM (A15)
0008  2 PERSONNEL-ID (A8) 
0009  2 MAKE (A20)
0010  2 MODEL (A20)
0011  2 COLOUR (A10)
0012  2 YEAR (N4.0)
00131 #INDEX (N3)
00141 #REG-NUM (A15/1:16)
00151 #PERSONNEL-ID (A8/1:16) /* NC
00161 #MAKE (A20/1:16)
00171 #MODEL (A20/1:16)
00181 #COLOUR (A10/1:16)
00191 #YEAR (N4.0/1:16)
00201 #MAKE-MODEL (A35/1:16)
0021END-DEFINE 
0022*
0023SET KEY/** %Y=GRPIYE
0024  PF3 NAMED 'EXIT'
0025  ENTR NAMED 'NEXT>>'
0026*
0027* FORMAT LS=100
0028*
0029READ (17) VEHICLES BY PERSONNEL-ID
0030
0031*
0032  ADD 1 TO #INDEX
0033*
0034  MOVE PERSONNEL-ID TO #PERSONNEL-ID(#INDEX)
0035  MOVE REG-NUM      TO #REG-NUM (#INDEX)
0036  MOVE MAKE         TO #MAKE (#INDEX)
0037  MOVE MODEL        TO #MODEL(#INDEX)
0038  MOVE COLOUR       TO #COLOUR(#INDEX)
0039  MOVE YEAR         TO #YEAR(#INDEX)
0040*
0041COMPRESS MAKE'-' MODEL INTO #MAKE-MODEL(#INDEX)
0042
0043  IF #INDEX = 16
0044*   RESET ##NAME(#INDEX+1:16) 
0045    INPUT USING MAP "VEHMAP16"
0046    RESET #INDEX
0047  END-IF
0048*
0049IF *PF-KEY = 'PF3'
0050ESCAPE BOTTOM
0051END-IF
0052*
0053END-READ
0054*
0055IF #INDEX < 16
0056  RESET #PERSONNEL-ID(#INDEX+1:16)
0057    #REG-NUM(#INDEX+1:16)
0058    #MAKE(#INDEX+1:16)
0059    #MODEL(#INDEX+1:16) 
0060    #COLOUR(#INDEX+1:16)
0061    #YEAR(#INDEX+1:16)
0062  INPUT USING MAP "VEHMAP16"
0063END-IF
0064END
