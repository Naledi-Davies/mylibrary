0005DEFINE DATA LOCAL
00061 NUMVALUE (N2) INIT <2>
00071 MESSAGE  (A50) INIT <'VALID'>
0008END-DEFINE
0009*
0010FOR NUMVALUE = 1 TO 20
0011DECIDE FOR EVERY CONDITION
0012  WHEN NUMVALUE = 1 OR NUMVALUE = 2 OR NUMVALUE = 3
0013    MESSAGE := 'VALUE IS 1,2 OR 3' /* FOR RANGE LIKE 1 TO 3 JUST USE A COLON (:)
0014  WHEN NUMVALUE = 5
0015    MESSAGE:= 'VALUE IS 5'
0016  WHEN NUMVALUE = 7 OR NUMVALUE = 8 OR NUMVALUE =10
0017    MESSAGE:= 'THE VALUE IS 7,8 OR 10'
0018WHEN NUMVALUE = 13 OR NUMVALUE = 15 OR NUMVALUE = 16 OR NUMVALUE = 17 OR NUMVALUE = 18
0019    MESSAGE:= 'VALUE IS 13 OR IS IN THE RANGE OF 15 TO 18'
0020  WHEN NONE
0021    MESSAGE:= 'INVALID VALUE'
0022END-DECIDE
0023WRITE MESSAGE
0024END-FOR
0025END
