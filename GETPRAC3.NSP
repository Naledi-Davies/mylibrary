0005DEFINE DATA LOCAL
00061 ALPHA (A20)
00071 DYN1  (A)       DYNAMIC
00081 DYN2  (A)       DYNAMIC
0009END-DEFINE
0010
0011MOVE '  AAA  ' TO ALPHA
0012MOVE ALPHA TO DYN1
0013WRITE 'LEN(DYN) AFTER MOVE' *LENGTH(DYN1)
0014*
0015COMPRESS ALPHA TO DYN1 /*COMPRESS STATEMENT IS TO REMOVE THE TRAILING BLANKS 
0016WRITE / 'LEN(DYN) AFTER COMPRESS' *LENGTH(DYN1)
0017*
0018MOVE ALL 'A' TO DYN1 UNTIL 13
0019WRITE / 'DYN AFTER MOVE ALL' DYN1 (AL=20) /* ALPHANUMERIC LENGTH (AL)
0020WRITE / 'LEN(DYN) AFTER MOVE ALL' *LENGTH(DYN1)
0021*
0022MOVE ALL ' ' TO DYN1 UNTIL 30
0023COMPRESS DYN1 TO DYN2
0024WRITE 'LEN(DYN1) AFTER COMPRESS' *LENGTH(DYN1)
0025WRITE 'LEN(DYN2) AFTER COMPRESS' *LENGTH(DYN2) /* WHEN YOU COMPRESS IT THE TRAILING BLANKS ARE REMOVED THEREFORE THE LENGTH WILL NOT BE RECOGNISED
0026END
