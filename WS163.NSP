0011/** :author tda
0012/* TODO Enter your code here
0013DEFINE DATA LOCAL
00141 EMPLOYEE VIEW OF EMPLOYEES
0015  2 PERSONNEL-ID (A8)
0016  2 NAME (A20)
0017  2 GENDER (A1)
0018  2 CITY (A20)
0019
00201 #EXIT (A9)
00211 #INDEX (I1)
00221 ##PERSONNEL-ID (A8/1:16)
00231 ##NAME (A20/1:16)
00241 ##GENGER (A1/1:16)
00251 ##CITY (A20/1:16)
0026***********************************************************
00271 #SELECT (A1/1:16)
00281 #SELECT-INDEX (N3)
0029***********************************************************
00301 #MAKE (A20/1:5)
00311 #MODEL (A20/1:5)
00321 #COLOUR (A10/1:5)
00331 #YEAR (N4.0/1:5)
0034END-DEFINE 
0035* 
0036SET KEY
0037  PF3 NAMED 'EXIT'
0038  ENTR NAMED 'NEXT>>'  
0039*
0040FORMAT LS=100
0041*
0042READ (20) EMPLOYEE BY PERSONNEL-ID
0043*
0044  ADD 1 TO #INDEX
0045*
0046  MOVE PERSONNEL-ID TO ##PERSONNEL-ID(#INDEX)
0047  MOVE NAME         TO ##NAME (#INDEX)
0048  MOVE GENDER       TO ##GENGER (#INDEX)
0049  MOVE CITY         TO ##CITY(#INDEX)
0050* 
0051  IF #INDEX=16
0052    INPUT USING MAP "WRK16PRO"
0053    IF *PF-KEY = 'PF3'
0054      ESCAPE BOTTOM
0055    END-IF
0056    RESET #INDEX
0057    FOR #SELECT-INDEX =1 TO 16
0058      IF #SELECT (#SELECT-INDEX)= 'X'
0059        CALLNAT "WK163SUB"
0060          ##PERSONNEL-ID(#SELECT-INDEX)
0061          ##NAME (#SELECT-INDEX)
0062        RESET #SELECT(#SELECT-INDEX)
0063      END-IF
0064    END-FOR
0065  END-IF
0066END-READ
0067IF #INDEX < 16
0068  RESET ##PERSONNEL-ID(#INDEX+1:16)
0069    ##NAME(#INDEX+1:16)
0070    ##GENGER(#INDEX+1:16)
0071    ##CITY(#INDEX+1:16)
0072  INPUT USING MAP "WRK16PRO"
0073END-IF
0074END
